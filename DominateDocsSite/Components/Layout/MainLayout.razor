﻿@using DominateDocsSite.State
@using MudBlazor.StaticInput
@using MudBlazor

@implements IDisposable
@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject UserSession Session
@inject IApplicationStateManager appState
@inject IJSRuntime JS
@inject NavigationManager Nav

<style>
    :root {
        --dd-topbar-height: 80px;
        --dd-drawer-width: 260px;
        --dd-drawer-bg: #3E566E;
    }

    /* ============================
           Fixed Logo Panel (above drawer, flush left)
           ============================ */
    .dd-logo-panel-fixed {
        position: fixed;
        top: 0;
        left: 0;
        height: var(--dd-topbar-height);
        width: var(--dd-drawer-width);
        background: #ffffff;
        display: flex;
        align-items: center;
        padding: 0 14px;
        border-right: 1px solid rgba(0,0,0,0.08);
        z-index: 1301; /* higher than appbar (default 1100-ish) */
    }

    .dd-top-logo {
        height: 56px;
        width: auto;
        display: block;
    }

    /* ============================
           Single Header (black) shifted right of logo panel
           ============================ */
    .top-header {
        background-color: #0a1929 !important;
        color: white !important;
        height: var(--dd-topbar-height) !important;
        min-height: var(--dd-topbar-height) !important;
        font-size: 13px;
        padding-left: 0 !important;
        /* Push header content right so it doesn't sit under the fixed logo panel */
        margin-left: var(--dd-drawer-width);
    }

        .top-header .mud-icon-root {
            color: white !important;
            font-size: 1.2rem;
        }

    /* Main content accounts for the single header height */
    .mud-main-content {
        padding-top: var(--dd-topbar-height) !important;
    }

    .contact-info-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 24px;
        white-space: nowrap;
    }

    .auth-links {
        display: flex;
        gap: 15px;
    }

    .auth-link {
        color: white !important;
        text-decoration: none;
    }

        .auth-link:hover {
            text-decoration: underline;
        }

    /* ============================
           Drawer + Nav Styling
           ============================ */
    #nav-drawer {
        background-color: var(--dd-drawer-bg) !important;
    }

    /* Drawer menu starts under the header/logo panel */
    .dd-drawer-menu {
        padding-top: var(--dd-topbar-height);
        padding-left: 6px;
        padding-right: 6px;
        padding-bottom: 12px;
    }

    /* Readable nav on dark drawer */
    #nav-drawer .mud-nav-link,
    #nav-drawer .mud-nav-group,
    #nav-drawer .mud-nav-group > .mud-nav-link {
        color: #ffffff !important;
    }

        #nav-drawer .mud-nav-link .mud-nav-link-text,
        #nav-drawer .mud-nav-group .mud-nav-link-text {
            color: #ffffff !important;
            opacity: 0.95;
        }

    #nav-drawer .mud-nav-link-icon,
    #nav-drawer .mud-nav-link-expand-icon,
    #nav-drawer .mud-icon-root {
        color: #ffffff !important;
        opacity: 0.95;
    }

    #nav-drawer .mud-nav-group > .mud-nav-link {
        padding-top: 6px !important;
        padding-bottom: 4px !important;
        margin-bottom: 0 !important;
    }

    #nav-drawer .mud-nav-link {
        padding-top: 6px !important;
        padding-bottom: 6px !important;
        border-radius: 6px;
    }

        #nav-drawer .mud-nav-link:hover {
            background-color: rgba(255,255,255,0.10) !important;
        }

        #nav-drawer .mud-nav-link.mud-nav-link-active {
            background-color: rgba(255,255,255,0.16) !important;
            font-weight: 600;
        }

    #nav-drawer .mud-nav-group {
        margin-top: 4px !important;
        margin-bottom: 4px !important;
    }
</style>

<MudThemeProvider Theme="(IsDark ? DominateDocsTheme.Dark : DominateDocsTheme.Light)" />

<CascadingAuthenticationState>
    <MudLayout>

        @* Fixed logo panel, aligned with drawer, above it, flush left *@
        <MudLink Href="/" Style="text-decoration:none;">
            <div class="dd-logo-panel-fixed">
                <img src="images/DominateDocs_NoCrop.png" class="dd-top-logo" alt="Dominate Docs Logo" />
            </div>
        </MudLink>

        @* --- SINGLE HEADER: Black bar (starts to the right of the fixed logo panel) --- *@
        <MudAppBar Elevation="0" Class="top-header" Fixed="true">

            @* Hamburger now sits at the left edge of the black header (right next to logo panel) *@
            @if (isAuthenticated)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               OnClick="@DrawerToggle"
                               Class="mr-2" />
            }

            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                <MudText Typo="Typo.body2">+1 (949) 500-7417</MudText>
            </div>

            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                <MudText Typo="Typo.body2">info@dominatedocs.ai</MudText>
            </div>

            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                <MudText Typo="Typo.body2">1600 Whispering Hills Drive Franklin, TN 37069</MudText>
            </div>

            <MudSpacer />

            <div class="auth-links">
                @if (!isAuthenticated)
                {
                    <MudLink Href="/Account/Register" Class="auth-link">Sign up</MudLink>
                    <MudLink Href="/Account/Login" Class="auth-link">Login</MudLink>
                }
                else
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <div style="display:flex; align-items:center; cursor:pointer;">
                                <MudText Typo="Typo.body2" Class="mr-2">@userName</MudText>
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@avaLetter</MudAvatar>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudList T="string" Dense="true">
                                <MudListItem Text="Account Settings" Href="/Account/Manage" />
                                <MudListItem Text="Default Profiles" Href="/UserDefaultProfile" />
                                <MudDivider />
                                <MudListItem Icon="@Icons.Material.Filled.Logout" Text="Logout" OnClick="SubmitLogout" />
                            </MudList>
                        </ChildContent>
                    </MudMenu>
                }
            </div>
        </MudAppBar>

        @* --- SIDEBAR (starts under the logo/header) --- *@
        @if (ShowAppSidebar)
        {
            <MudDrawer id="nav-drawer"
                       @bind-Open="_drawerOpen"
                       Variant="DrawerVariant.Responsive"
                       ClipMode="DrawerClipMode.Never"
                       Elevation="2"
                       Width="260px">

                <div class="dd-drawer-menu">
                    <MudBlazorNavMenu />
                </div>

            </MudDrawer>
        }

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>

        <form @ref="_logoutForm" method="post" action="/auth/logout" style="display:none">
            <button type="submit">Logout</button>
        </form>

    </MudLayout>
</CascadingAuthenticationState>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] public bool ShowAppSidebar { get; set; } = true;

    private bool IsDark = false;
    private bool _drawerOpen = true;

    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private UserProfile userProfile;
    private ElementReference _logoutForm;

    string avaLetter => !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var userId = auth.User.GetUserId();
        var name = auth.User.GetDisplayName();

        isAuthenticated = auth.User.Identity?.IsAuthenticated ?? false;
        userName = auth.User.Identity?.Name ?? "";

        if (isAuthenticated)
        {
            userProfile = await appState.GetUserProfileByIdAsync(Guid.Parse(userId));

            if (userProfile is null)
            {
                userProfile = new UserProfile
                {
                    UserId = Guid.Parse(userId),
                    UserName = userName,
                    Name = name,
                    Email = auth.User.Identity?.Name,
                };

                appState.CreateUserProfile(userProfile);
            }

            Session.UserId = userProfile.UserId;
            Session.Email = userProfile.Email;
            Session.UserName = userProfile.UserName;

            Session.DocLibId = Guid.Parse("533fb231-20f3-4819-8d83-64ede387bd02");

            var roles = appState.GetRoles();
            Session.UserRole = roles.FirstOrDefault();

            if (!appState.ActiveSessions.ContainsKey(userName))
                appState.ActiveSessions.TryAdd(userName, userProfile);
        }

        _drawerOpen = ShowAppSidebar;

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private async Task SubmitLogout() => await JS.InvokeVoidAsync("submitLogoutForm", _logoutForm);

    private void DrawerToggle()
    {
        if (!ShowAppSidebar)
            return;

        _drawerOpen = !_drawerOpen;
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
