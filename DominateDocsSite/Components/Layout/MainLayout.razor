@using DominateDocsSite.State
@using MudBlazor.StaticInput
@using MudBlazor

@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject UserSession Session
@inject IApplicationStateManager appState
@inject IJSRuntime JS
@inject NavigationManager Nav

<style>
    .top-header {
        background-color: #0a1929 !important; /* Dark Navy/Black */
        color: white !important;
        height: 40px !important;
        min-height: 40px !important;
        font-size: 13px;
    }

        .top-header .mud-icon-root {
            color: white !important;
            font-size: 1.2rem;
        }

    .main-header {
        background-color: white !important;
        color: #333 !important;
        height: 80px !important;
        top: 40px !important; /* Offset by top header height */
    }

    .menu-link {
        color: #333 !important;
        text-decoration: none;
        font-weight: 500;
        padding: 0 15px;
        font-size: 16px;
        transition: color 0.3s;
    }

        .menu-link:hover {
            color: #0d6efd !important;
        }

    /* Adjust main content to account for double header */
    .mud-main-content {
        padding-top: 120px !important;
    }

    .contact-info-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 24px;
        white-space: nowrap;
    }

    .auth-links {
        display: flex;
        gap: 15px;
    }

    .auth-link {
        color: white !important;
        text-decoration: none;
    }

        .auth-link:hover {
            text-decoration: underline;
        }
</style>

<MudThemeProvider Theme="(IsDark ? DominateDocsTheme.Dark : DominateDocsTheme.Light)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <MudLayout>

        @* --- TOP BLACK HEADER --- *@
        <MudAppBar Elevation="0" Class="top-header" Fixed="true">
            @if (isAuthenticated && (Session.UserRole == "Admin" || Session.UserRole == "DevAdmin"))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" Class="mr-2" />
            }

            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                <MudText Typo="Typo.body2">+1 (949) 500-7417</MudText>
            </div>
            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                <MudText Typo="Typo.body2">info@dominatedocs.ai</MudText>
            </div>
            <div class="contact-info-item">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                <MudText Typo="Typo.body2">1600 Whispering Hills Drive Franklin, TN 37069</MudText>
            </div>

            <MudSpacer />

            <div class="auth-links">
                @if (!isAuthenticated)
                {
                    <MudLink Href="/Account/Register" Class="auth-link">Sign up</MudLink>
                    <MudLink Href="/Account/Login" Class="auth-link">Login</MudLink>
                }
                else
                {
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent>
                            <div style="display:flex; align-items:center; cursor:pointer;">
                                <MudText Typo="Typo.body2" Class="mr-2">@userName</MudText>
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@avaLetter</MudAvatar>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudList T="string" Dense="true">
                                <MudListItem Text="Account Settings" Href="/Account/Manage" />
                                <MudListItem Text="Default Profiles" Href="/UserDefaultProfile" />
                                <MudDivider />
                                <MudListItem Icon="@Icons.Material.Filled.Logout" Text="Logout" OnClick="SubmitLogout" />
                            </MudList>
                        </ChildContent>
                    </MudMenu>
                }
            </div>
        </MudAppBar>

        @* --- MAIN WHITE HEADER --- *@
        <MudAppBar Elevation="1" Class="main-header" Fixed="true" Dense="false">
            <MudLink Href="/">
                <img src="images/DominateDocs_NoCrop.png" height="50" alt="Dominate Docs Logo" />
            </MudLink>

            <MudSpacer />

            <div class="d-flex align-center">
               @*  <MudLink Href="/whyarewedifferent" Class="menu-link">Why We Are Different</MudLink>
                <MudLink Href="/about" Class="menu-link">About Us</MudLink>
                <MudLink Href="/faqs" Class="menu-link">FAQs</MudLink>
                <MudLink Href="/contactus" Class="menu-link">Contact Us</MudLink> *@
            </div>
        </MudAppBar>

        @* --- SIDEBAR --- *@
        @if (ShowAppSidebar)
        {
            <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Never" Elevation="2">
                <MudBlazorNavMenu />
            </MudDrawer>
        }

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>

        <form @ref="_logoutForm" method="post" action="/auth/logout" style="display:none">
            <button type="submit">Logout</button>
        </form>

    </MudLayout>
</CascadingAuthenticationState>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] public bool ShowAppSidebar { get; set; } = true;

    private bool IsDark = false;
    private bool _drawerOpen = false;
    private bool isAuthenticated = false;
    private string userName = string.Empty;
    private UserProfile userProfile;
    private ElementReference _logoutForm;

    string avaLetter => !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "?";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        var userId = auth.User.GetUserId();
        var name = auth.User.GetDisplayName();

        isAuthenticated = auth.User.Identity.IsAuthenticated;
        userName = auth.User.Identity.Name ?? "";

        if (isAuthenticated)
        {
            userProfile = await appState.GetUserProfileByIdAsync(Guid.Parse(userId));

            if (userProfile is null)
            {
                userProfile = new UserProfile
                {
                    UserId = Guid.Parse(userId),
                    UserName = userName,
                    Name = name,
                    Email = auth.User.Identity.Name,
                };

                appState.CreateUserProfile(userProfile);
            }

            Session.UserId = userProfile.UserId;
            Session.Email = userProfile.Email;
            Session.UserName = userProfile.UserName;

            Session.DocLibId = Guid.Parse("533fb231-20f3-4819-8d83-64ede387bd02");

            var roles = appState.GetRoles();
            Session.UserRole = roles.FirstOrDefault();

            if (!appState.ActiveSessions.ContainsKey(userName))
                appState.ActiveSessions.TryAdd(userName, userProfile);
        }

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private async Task SubmitLogout() => await JS.InvokeVoidAsync("submitLogoutForm", _logoutForm);

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}