@using DominateDocsData.Enums
@using DominateDocsData.Models
@using DominateDocsData.Models.MergeDTOs
@using DominateDocsSite.ViewModels
@inject LoanWizardPropertyViewModel vm
@inject ISnackbar Snackbar

<div @key="vm.EditingRecord">
    <MudPaper Outlined="true" Class="pa-4 mt-4" Style="border-radius: 12px; border: 1px solid #e0e0e0;">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Medium" Color="Color.Default" />
                <MudText Typo="Typo.h6" Style="font-weight: 600;">Property</MudText>
            </MudStack>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="HandleAdd">Add Property</MudButton>
        </MudStack>

        <MudAutocomplete T="DominateDocsData.Models.PropertyRecord"
                         Label="Search saved properties..."
                         Value="@vm.SelectedRecord"
                         ValueChanged="@(async (DominateDocsData.Models.PropertyRecord p) => await LoadSelectedPropertyAsync(p))"
                         SearchFunc="@SearchFunc"
                         ToStringFunc="@(p => p?.FullAddress ?? p?.LegalDescription)"
                         Variant="Variant.Outlined"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Default"
                         Class="mb-4"
                         Dense="true"
                         Margin="Margin.Dense" />

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="DominateDocsData.Enums.Property.Types" Label="PROPERTY TYPE" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="vm.EditingRecord.PropertyType">
                    @foreach (var propertyType in Enum.GetValues<DominateDocsData.Enums.Property.Types>())
                    {
                        <MudSelectItem T="DominateDocsData.Enums.Property.Types" Value="@propertyType">@propertyType.GetDescription()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8">
                <div style="margin-left: -16px; margin-right: -12px; margin-top:-8px;">
                    <AddressCompleteMap AddressList="@addressList" OnAddressChange="HandleAddressChange" Row="false" MultipleAddress="false" />
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="vm.EditingRecord.ParcelNumber" Label="APN / PARCEL" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" @bind-Value="vm.EditingRecord.EstimatedValue" Label="ESTIMATED VALUE" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="vm.EditingRecord.LegalDescription" Label="LEGAL DESCRIPTION" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" />
            </MudItem>
        </MudGrid>

        <MudPaper Outlined="true" Class="pa-4 mt-4" Style="border-radius:12px; border:1px solid #e5e7eb; background:#fafafa;">
            <MudText Typo="Typo.subtitle2" Style="font-weight:700; color:#0f172a;">Property Owner</MudText>
            <MudStack Row="true" Spacing="2" Class="mt-3 flex-wrap">
                <MudButton Variant="@(vm.EditingRecord.IsPropertyOwnerSameAsBorrower? Variant.Filled: Variant.Outlined)"
                           Color="@(vm.EditingRecord.IsPropertyOwnerSameAsBorrower ? Color.Dark : Color.Default)"
                           OnClick="SetOwnerModeBorrowerAsync"
                           Style="text-transform:none; border-radius:8px;">Same as Borrower</MudButton>
                <MudButton Variant="@(vm.EditingRecord.IsPropertyOwnerSameAsGuarantor? Variant.Filled: Variant.Outlined)"
                           Color="@(vm.EditingRecord.IsPropertyOwnerSameAsGuarantor ? Color.Dark : Color.Default)"
                           OnClick="SetOwnerModeGuarantorAsync"
                           Style="text-transform:none; border-radius:8px;">Same as Guarantor</MudButton>
                <MudButton Variant="@(vm.EditingRecord.IsPropertyOwnerThridPartyOwner? Variant.Filled: Variant.Outlined)"
                           Color="@(vm.EditingRecord.IsPropertyOwnerThridPartyOwner ? Color.Dark : Color.Default)"
                           OnClick="SetOwnerModeThirdParty"
                           Style="text-transform:none; border-radius:8px;">Third-Party Owner</MudButton>
            </MudStack>

            @if (ShowOwnersSection)
            {
                <MudDivider Class="my-4" />

                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;color:#0f2b4a;">Property Owners (@(vm.EditingRecord.PropertyOwners?.Count ?? 0))</MudText>
                    @if (vm.EditingRecord.IsPropertyOwnerThridPartyOwner)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="OnAddOwner" Style="text-transform:none;">Add Owner</MudButton>
                    }
                </div>

                @if (vm.EditingRecord.PropertyOwners?.Any() == true)
                {
                    @foreach (var owner in vm.EditingRecord.PropertyOwners)
                    {
                        <div class="pa-3 mb-3 d-flex justify-space-between align-center" style="background:#f1f5f9; border-radius:8px; border:1px solid #e2e8f0;">
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:700; color:#0f2b4a;">@GetOwnerDisplayName(owner)</MudText>
                                <MudText Typo="Typo.caption" Style="color:#64748b;">@owner.EntityType.GetDescription() · @owner.PercentageOfOwnership%</MudText>
                            </div>
                            <div class="d-flex">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OnSelectedOwner(owner))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OnRemoveOwner(owner))" />
                            </div>
                        </div>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                        No owners added yet.
                    </MudAlert>
                }

                @if (AddEditOwner)
                {
                    <LoanWizardPropertyOwner SelectedOwner="selectedOwner"
                                             ExistingOwners="vm.EditingRecord.PropertyOwners"
                                             OnOwnerComplete="@(new Microsoft.AspNetCore.Components.EventCallback<DominateDocsData.Models.PropertyOwner>(null, (DominateDocsData.Models.PropertyOwner owner) => OnOwnerComplete(owner)))"
                                             OnOwnerCanceled="OnOwnerCanceled" />
                }
            }
        </MudPaper>

        <MudStack Row Justify="Justify.Center" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleUpsert" Style="min-width: 120px; border-radius: 8px;">Save Property</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="HandleCancel" Style="min-width: 120px; border-radius: 8px;">Cancel</MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    [Parameter] public DominateDocsData.Models.PropertyRecord SelectedProperty { get; set; }
    [Parameter] public List<DominateDocsData.Models.PropertyRecord> CurrentProperties { get; set; } = new();
    [Parameter] public IEnumerable<DominateDocsData.Models.EntityBase> Borrowers { get; set; } = Enumerable.Empty<DominateDocsData.Models.EntityBase>();
    [Parameter] public IEnumerable<DominateDocsData.Models.EntityBase> Guarantors { get; set; } = Enumerable.Empty<DominateDocsData.Models.EntityBase>();
    [Parameter] public EventCallback<DominateDocsData.Models.PropertyRecord> OnPropertyComplete { get; set; }
    [Parameter] public EventCallback OnPropertyCanceled { get; set; }

    private List<AddressDTO> addressList = new();
    private bool AddEditOwner;
    private DominateDocsData.Models.PropertyOwner selectedOwner;

    private bool ShowOwnersSection =>
        vm?.EditingRecord?.PropertyOwners?.Any() == true ||
        vm?.EditingRecord?.IsPropertyOwnerSameAsBorrower == true ||
        vm?.EditingRecord?.IsPropertyOwnerSameAsGuarantor == true ||
        vm?.EditingRecord?.IsPropertyOwnerThridPartyOwner == true;

    protected override async Task OnInitializedAsync()
    {
        vm.SetSnackbar(Snackbar);
        await vm.InitializeEditorAsync(SelectedProperty, CurrentProperties);
        SyncAddressList();
        await EnsureModeOwnersVisibleAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await vm.InitializeEditorAsync(SelectedProperty, CurrentProperties);
        SyncAddressList();
        await EnsureModeOwnersVisibleAsync();
    }

    private async Task LoadSelectedPropertyAsync(DominateDocsData.Models.PropertyRecord property)
    {
        await vm.InitializeEditorAsync(property, CurrentProperties);
        AddEditOwner = false;
        selectedOwner = null;
        SyncAddressList();
        await EnsureModeOwnersVisibleAsync();
        StateHasChanged();
    }

    private async Task HandleAdd()
    {
        vm.ClearSelection();
        AddEditOwner = false;
        selectedOwner = null;
        SyncAddressList();
        await EnsureModeOwnersVisibleAsync();
        StateHasChanged();
    }

    private void SyncAddressList()
    {
        addressList.Clear();
        if (!string.IsNullOrWhiteSpace(vm.EditingRecord?.FullAddress))
        {
            addressList.Add(new AddressDTO
            {
                FullAddress = vm.EditingRecord.FullAddress,
                StreetAddress = vm.EditingRecord.StreetAddress,
                City = vm.EditingRecord.City,
                State = vm.EditingRecord.State,
                ZipCode = vm.EditingRecord.ZipCode,
                County = vm.EditingRecord.County,
                Country = vm.EditingRecord.Country,
                Lat = vm.EditingRecord.Lat ?? 0,
                Lng = vm.EditingRecord.Lng ?? 0
            });
        }
    }

    private void HandleAddressChange(List<AddressDTO> addresses)
    {
        var addr = addresses.FirstOrDefault();
        if (addr is null)
            return;

        vm.EditingRecord.FullAddress = addr.FullAddress;
        vm.EditingRecord.StreetAddress = addr.StreetAddress;
        vm.EditingRecord.City = addr.City;
        vm.EditingRecord.State = addr.State;
        vm.EditingRecord.ZipCode = addr.ZipCode;
        vm.EditingRecord.County = addr.County;
        vm.EditingRecord.Country = addr.Country;
        vm.EditingRecord.Lat = addr.Lat;
        vm.EditingRecord.Lng = addr.Lng;
    }

    private async Task EnsureModeOwnersVisibleAsync()
    {
        if (vm.EditingRecord is null)
            return;

        vm.EditingRecord.PropertyOwners ??= new List<DominateDocsData.Models.PropertyOwner>();

        if (vm.EditingRecord.IsPropertyOwnerSameAsBorrower && !vm.EditingRecord.PropertyOwners.Any())
        {
            await PopulateOwnersFromPartiesAsync(Borrowers, borrowerMode: true);
            return;
        }

        if (vm.EditingRecord.IsPropertyOwnerSameAsGuarantor && !vm.EditingRecord.PropertyOwners.Any())
        {
            await PopulateOwnersFromPartiesAsync(Guarantors, borrowerMode: false);
            return;
        }
    }

    private async Task SetOwnerModeBorrowerAsync()
    {
        vm.EditingRecord.IsPropertyOwnerSameAsBorrower = true;
        vm.EditingRecord.IsPropertyOwnerSameAsGuarantor = false;
        vm.EditingRecord.IsPropertyOwnerThridPartyOwner = false;
        AddEditOwner = false;
        selectedOwner = null;

        await PopulateOwnersFromPartiesAsync(Borrowers, borrowerMode: true);
        StateHasChanged();
    }

    private async Task SetOwnerModeGuarantorAsync()
    {
        vm.EditingRecord.IsPropertyOwnerSameAsBorrower = false;
        vm.EditingRecord.IsPropertyOwnerSameAsGuarantor = true;
        vm.EditingRecord.IsPropertyOwnerThridPartyOwner = false;
        AddEditOwner = false;
        selectedOwner = null;

        await PopulateOwnersFromPartiesAsync(Guarantors, borrowerMode: false);
        StateHasChanged();
    }

    private void SetOwnerModeThirdParty()
    {
        vm.EditingRecord.IsPropertyOwnerSameAsBorrower = false;
        vm.EditingRecord.IsPropertyOwnerSameAsGuarantor = false;
        vm.EditingRecord.IsPropertyOwnerThridPartyOwner = true;
    }

    private async Task PopulateOwnersFromPartiesAsync(IEnumerable<DominateDocsData.Models.EntityBase> sourceParties, bool borrowerMode)
    {
        vm.EditingRecord.PropertyOwners ??= new List<DominateDocsData.Models.PropertyOwner>();

        var parties = (sourceParties ?? Enumerable.Empty<DominateDocsData.Models.EntityBase>())
            .Where(x => x is not null)
            .ToList();

        if (!parties.Any())
        {
            vm.EditingRecord.PropertyOwners.Clear();
            Snackbar.Add(borrowerMode ? "No borrower records are available to add as property owners." : "No guarantor records are available to add as property owners.", Severity.Warning);
            return;
        }

        var newOwners = new List<DominateDocsData.Models.PropertyOwner>();
        var percentBase = 100 / parties.Count;
        var remainder = 100 % parties.Count;

        for (int i = 0; i < parties.Count; i++)
        {
            var owner = MapPartyToPropertyOwner(parties[i]);
            owner.PercentageOfOwnership = percentBase + (i == 0 ? remainder : 0);
            newOwners.Add(owner);
        }

        vm.EditingRecord.PropertyOwners = newOwners;
        await Task.CompletedTask;
    }

    private static DominateDocsData.Models.PropertyOwner MapPartyToPropertyOwner(DominateDocsData.Models.EntityBase source)
    {
        return new DominateDocsData.Models.PropertyOwner
        {
            Id = Guid.NewGuid(),
            UserId = source.UserId,
            UserDefaultProfileId = source.UserDefaultProfileId,
            DefaultDocLibraryId = source.DefaultDocLibraryId,
            ReferenceCode = $"PO-{Guid.NewGuid():N}"[..11],
            EntityName = source.EntityName,
            EntityType = source.EntityType,
            EntityStructure = source.EntityStructure,
            StateOfOrganization = source.StateOfOrganization,
            PreferredStateVenue = source.PreferredStateVenue,
            ContactName = source.ContactName,
            ContactEmail = source.ContactEmail,
            ContactPhoneNumber = source.ContactPhoneNumber,
            ContactTitle = source.ContactTitle,
            FullAddress = source.FullAddress,
            StreetAddress = source.StreetAddress,
            City = source.City,
            State = source.State,
            ZipCode = source.ZipCode,
            County = source.County,
            Country = source.Country,
            Lat = source.Lat,
            Lng = source.Lng,
            EIN = source.EIN,
            SSN = source.SSN,
            IsStateLicense = source.IsStateLicense,
            IsCflLicensed = source.IsCflLicensed,
            StateLicenses = source.StateLicenses?.Select(x => new DominateDocsData.Models.License
            {
                Id = x.Id,
                State = x.State,
                LicenseNumber = x.LicenseNumber
            }).ToList() ?? new List<DominateDocsData.Models.License>(),
            AliasNames = source.AliasNames?.ToList() ?? new List<string>(),
            AliasNamesOld = source.AliasNamesOld?.Select(x => new DominateDocsData.Models.AkaName
            {
                Id = x.Id,
                Name = x.Name
            }).ToList() ?? new List<DominateDocsData.Models.AkaName>(),
            AliasNamesFormatted = source.AliasNamesFormatted,
            IsAliasNamesUsed = source.IsAliasNamesUsed,
            EntityOwners = source.EntityOwners?.ToList() ?? new List<DominateDocsData.Models.EntityOwner>(),
            EntityOwnersFormatted = source.EntityOwnersFormatted,
            Trustees = source.Trustees?.ToList() ?? new List<DominateDocsData.Models.Trustee>(),
            TrusteesFormatted = source.TrusteesFormatted,
            SigningAuthorities = source.SigningAuthorities?.ToList() ?? new List<DominateDocsData.Models.SigningAuthority>(),
            IsSignatureAuthority = source.IsSignatureAuthority,
            SignatureLinesFormatted = source.SignatureLinesFormatted,
            FormattedName = source.FormattedName,
            IsAForgeinNational = source.IsAForgeinNational,
            IsLanuageTranslatorRequired = source.IsLanuageTranslatorRequired,
            PercentageOfOwnership = 100
        };
    }

    private void OnAddOwner()
    {
        selectedOwner = null;
        AddEditOwner = true;
        StateHasChanged();
    }

    private void OnSelectedOwner(DominateDocsData.Models.PropertyOwner owner)
    {
        selectedOwner = owner;
        AddEditOwner = true;
        StateHasChanged();
    }

    private void OnRemoveOwner(DominateDocsData.Models.PropertyOwner owner)
    {
        int index = vm.EditingRecord.PropertyOwners.FindIndex(x => x.Id == owner.Id);
        if (index > -1)
            vm.EditingRecord.PropertyOwners.RemoveAt(index);

        StateHasChanged();
    }

    private void OnOwnerComplete(DominateDocsData.Models.PropertyOwner owner)
    {
        int index = vm.EditingRecord.PropertyOwners.FindIndex(x => x.Id == owner.Id);
        if (index > -1)
            vm.EditingRecord.PropertyOwners[index] = owner;
        else
            vm.EditingRecord.PropertyOwners.Add(owner);

        AddEditOwner = false;
        selectedOwner = null;
        StateHasChanged();
    }

    private void OnOwnerCanceled()
    {
        AddEditOwner = false;
        selectedOwner = null;
        StateHasChanged();
    }

    private async Task HandleUpsert()
    {
        await vm.UpsertRecordCommand.ExecuteAsync(null);
        if (vm.LastUpsertSucceeded && OnPropertyComplete.HasDelegate)
            await OnPropertyComplete.InvokeAsync(vm.EditingRecord);
    }

    private async Task HandleCancel()
    {
        vm.ClearSelection();
        AddEditOwner = false;
        selectedOwner = null;
        SyncAddressList();
        if (OnPropertyCanceled.HasDelegate)
            await OnPropertyCanceled.InvokeAsync();
    }

    private async Task<IEnumerable<DominateDocsData.Models.PropertyRecord>> SearchFunc(string value, System.Threading.CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return vm.RecordList;

        return vm.RecordList.Where(x =>
            (x.FullAddress ?? string.Empty).Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            (x.LegalDescription ?? string.Empty).Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            (x.ParcelNumber ?? string.Empty).Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private static string GetOwnerDisplayName(DominateDocsData.Models.PropertyOwner owner)
    {
        if (!string.IsNullOrWhiteSpace(owner.EntityName))
            return owner.EntityName;

        if (!string.IsNullOrWhiteSpace(owner.ContactName))
            return owner.ContactName;

        return "Owner";
    }
}
