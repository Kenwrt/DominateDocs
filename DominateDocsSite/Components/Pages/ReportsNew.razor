@page "/reportsnew"

@using DominateDocsData.Models
@using DominateDocsData.Models.Enums
@using DominateDocsSite.ViewModels


@inject ReportsViewModel vm

<PageTitle>Dominate Docs — Reports</PageTitle>

@* ── Header ── *@
<div class="d-flex justify-space-between align-start mb-6">
    <div>
        <MudText Typo="Typo.caption" Style="color:#94a3b8;font-weight:500;">Loan History &amp; Files</MudText>
        <MudText Typo="Typo.h4" Style="font-family:'Outfit';color:#0f2b4a;letter-spacing:-0.5px;">Reports</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
               Style="text-transform:none;font-weight:600;">Export CSV</MudButton>
</div>

@* ── Search & Filters ── *@
<div class="d-flex gap-3 align-center mb-5">
    <MudTextField T="string" Placeholder="Search by loan name, borrower, property address..."
                  Variant="Variant.Outlined" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Value="@vm.SearchQuery" ValueChanged="@(v => vm.Search(v))"
                  Immediate="true" DebounceInterval="300"
                  Style="flex:1;" />
    <MudChipSet T="string" SelectedValueChanged="@(v => vm.SetFilter(v ?? "All"))"
                SelectionMode="SelectionMode.SingleSelection">
        <MudChip T="string" Value="@("All")" Default="true" Size="Size.Small" Variant="Variant.Text"
                 Style="font-size:12px;">All</MudChip>
        <MudChip T="string" Value="@("Active")" Size="Size.Small" Variant="Variant.Text"
                 Style="font-size:12px;">Active</MudChip>
        <MudChip T="string" Value="@("Closed")" Size="Size.Small" Variant="Variant.Text"
                 Style="font-size:12px;">Closed</MudChip>
       
    </MudChipSet>
</div>

@* ── Loans Table ── *@
<MudPaper Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
    <MudTable Items="@vm.FilteredLoans" Hover="true" Dense="true" RowClass="cursor-pointer"
              Style="font-size:13.5px;" Loading="false" FixedHeader="true">
        <HeaderContent>
            <MudTh Style="@_thStyle">Loan Name</MudTh>
            <MudTh Style="@_thStyle">Borrower</MudTh>
            <MudTh Style="@_thStyle">Amount</MudTh>
            <MudTh Style="@_thStyle">Date Created</MudTh>
            <MudTh Style="@_thStyle">Status</MudTh>
            <MudTh Style="@_thStyle">Documents</MudTh>
            <MudTh Style="@_thStyle"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div>
                    <MudText Style="font-weight:600;color:#0f172a;font-size:13.5px;">@context.ReferenceName</MudText>
                    <MudText Typo="Typo.caption" Style="color:#94a3b8;">@TruncateAddress(context.Properties.Select(x => x.FullAddress).FirstOrDefault()?? "Address Unknown")</MudText>
                </div>
            </MudTd>
            <MudTd Style="font-size:13px;color:#475569;">
                @(context.Borrowers.FirstOrDefault()?.EntityName ?? "—")
            </MudTd>
            <MudTd Style="font-weight:600;color:#0f2b4a;font-variant-numeric:tabular-nums;">
                $@context.PrincipalAmount
            </MudTd>
            <MudTd Style="font-size:13px;color:#94a3b8;">
                @context.OriginationDate
            </MudTd>
            <MudTd>
                <StatusBadge Status="@context.Status.GetDescription()" />
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Style="background:#f6f8fb;font-size:12px;font-weight:600;color:#475569;">
                   @*  <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1"
                             Style="font-size:14px;" />
                    @GetDocCount(context) docs *@
                </MudChip>
            </MudTd>
            <MudTd>
                <div class="d-flex gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                   Title="Download All" Style="color:#94a3b8;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Title="View" Style="color:#94a3b8;" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="d-flex flex-column align-center py-12">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#cbd5e1;" Class="mb-3" />
                <MudText Typo="Typo.subtitle1" Style="color:#64748b;font-weight:600;">No loans found</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;">
                    Try adjusting your search or filter criteria.
                </MudText>
            </div>
        </NoRecordsContent>
    </MudTable>

    <div class="d-flex align-center justify-space-between pa-3" style="border-top:1px solid #f1f5f9;">
        <MudText Typo="Typo.caption" Style="color:#94a3b8;">
            Showing @vm.FilteredLoans.Count of @vm.AgreementList.Count loans
        </MudText>
        <MudLink Typo="Typo.caption" Style="font-weight:600;cursor:pointer;">
            Load more →
        </MudLink>
    </div>
</MudPaper>

@code {
    private const string _thStyle = "font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#94a3b8;";

    private static string TruncateAddress(string address) =>
        address.Length > 35 ? address[..35] + "..." : address;

