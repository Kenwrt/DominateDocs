@page "/adminbench"

@using DocumentManager.State
@using MudBlazor
@using DominateDocsSite.ViewModels
@using DominateDocsData.Enums
@using DominateDocsData.Models
@using DocumentManager.Email
@using DominateDocsData.Database
@using DominateDocsSite.State

@namespace DominateDocsSite.ViewModels

@inject AdminBenchViewModel vm
@inject IMongoDatabaseRepo db
@inject UserSession Session

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudPaper Class="pa-4" Elevation="1">

        <MudText Typo="Typo.h6">Admin Bench</MudText>

        <MudDivider Class="my-4" />

        <MudGrid GutterSize="3">

            <MudItem xs="12" md="6">
                <MudSelect T="Guid"
                           Label="Doc Library"
                           Variant="Variant.Outlined"
                           @bind-Value="vm.SelectedDocLibId"
                           @bind-Value:after="OnDocLibChangedAsync">
                    @foreach (var id in vm.DocLibIds)
                    {
                        <MudSelectItem Value="id">@GetDocLibDisplayName(id)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="DocumentTypes.OutputTypes"
                           Label="Output Type (bench override)"
                           Variant="Variant.Outlined"
                           @bind-Value="vm.OutputType">
                    <MudSelectItem Value="DocumentTypes.OutputTypes.PDF">PDF</MudSelectItem>
                    <MudSelectItem Value="DocumentTypes.OutputTypes.DOCX">DOCX</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="EmailEnums.AttachmentOutput"
                           Label="Email Attachment Mode"
                           Variant="Variant.Outlined"
                           @bind-Value="vm.EmailAttachmentOutput">
                    <MudSelectItem Value="EmailEnums.AttachmentOutput.IndividualDocument">Individual Documents</MudSelectItem>
                    <MudSelectItem Value="EmailEnums.AttachmentOutput.ZipFile">Single ZIP File</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="Email To (optional)"
                              Variant="Variant.Outlined"
                              @bind-Value="vm.EmailTo" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="DominateDocsData.Models.LoanAgreement"
                           Label="Loan Agreement"
                           Variant="Variant.Outlined"
                           @bind-Value="vm.SelectedLoanAgreement"
                           @bind-Value:after="vm.OnLoanAgreementChangedAsync">
                    @foreach (var loan in vm.LoanAgreements)
                    {
                        <MudSelectItem Value="loan">@vm.GetLoanLabel(loan)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="DominateDocsData.Models.LoanType"
                           Label="Loan Type"
                           Variant="Variant.Outlined"
                           @bind-Value="vm.SelectedLoanType"
                           @bind-Value:after="vm.OnLoanTypeChangedAsync">
                    @foreach (var lt in vm.LoanTypes)
                    {
                        <MudSelectItem Value="lt">@lt.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!vm.CanRunOneButton || vm.IsBusy)"
                           OnClick="vm.RunMergeAndEmailAsync">
                    RUN MERGE + EMAIL
                </MudButton>
            </MudItem>

            <MudItem xs="12">
                @if (!string.IsNullOrWhiteSpace(vm.Status))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">@vm.Status</MudAlert>
                }
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mt-2">Persisted Deliveries</MudText>

                @if (vm.SelectedLoanDeliveries.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        No deliveries saved on this loan (yet). The Run button will generate them first.
                    </MudText>
                }
                else
                {
                    <MudTable Items="vm.SelectedLoanDeliveries" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Document</MudTh>
                            <MudTh>DocId</MudTh>
                            <MudTh>Output</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Location</MudTh>
                            <MudTh>Copies</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@vm.GetDocName(context.DocId)</MudTd>
                            <MudTd>@context.DocId</MudTd>
                            <MudTd>@context.OutputType</MudTd>
                            <MudTd>@context.DelieveryTypes</MudTd>
                            <MudTd>@context.DeliveryLoaction</MudTd>
                            <MudTd>@context.Copies</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudText Typo="Typo.subtitle2">Live Merge Results</MudText>

                @if (vm.LiveMergeRows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No merges yet.</MudText>
                }
                else
                {
                    <MudTable Items="vm.LiveMergeRows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Status</MudTh>
                            <MudTh>Document</MudTh>
                            <MudTh>Completed</MudTh>
                            <MudTh>Bytes</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Status</MudTd>
                            <MudTd>@context.DocumentName</MudTd>
                            <MudTd>@context.CompletedLocal</MudTd>
                            <MudTd>@context.Bytes</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>

        </MudGrid>
    </MudPaper>
</MudContainer>

@code
{
    private Dictionary<Guid, string> _docLibNamesById = new();

    protected override async Task OnInitializedAsync()
    {
        await vm.InitializeAsync();

        // Build DocLibId -> Name map for display in dropdown.
        // If you have 1,000 doc libraries someday, congrats on your success and also your future pain.
        try
        {
            var libs = db.GetRecords<DominateDocsData.Models.DocumentLibrary>();
            _docLibNamesById = libs
                .Where(x => x is not null && x.Id != Guid.Empty)
                .GroupBy(x => x.Id)
                .ToDictionary(g => g.Key, g => g.First().Name ?? g.Key.ToString());
        }
        catch
        {
            _docLibNamesById = new Dictionary<Guid, string>();
        }

        // Default email to logged-in user (Session.Email) if not already set.
        try
        {
            if (string.IsNullOrWhiteSpace(vm.EmailTo) && !string.IsNullOrWhiteSpace(Session?.Email))
                vm.EmailTo = Session.Email;
        }
        catch
        {
            // no-op: keep UI resilient even if Session isn't wired for some reason
        }
    }

    private async Task OnDocLibChangedAsync()
    {
        await vm.OnDocLibChangedAsync();

        // Rebuild map in case doc libraries were changed/added.
        try
        {
            var libs = db.GetRecords<DominateDocsData.Models.DocumentLibrary>();
            _docLibNamesById = libs
                .Where(x => x is not null && x.Id != Guid.Empty)
                .GroupBy(x => x.Id)
                .ToDictionary(g => g.Key, g => g.First().Name ?? g.Key.ToString());
        }
        catch
        {
            // ignore
        }
    }

    private string GetDocLibDisplayName(Guid id)
    {
        if (id == Guid.Empty) return "";

        if (_docLibNamesById.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name))
            return name;

        return id.ToString();
    }
}
