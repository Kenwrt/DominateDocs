@page "/broker"
@using System.Text
@using Blazored.FluentValidation
@using DominateDocsData.Models
@using DominateDocsData.Enums
@using DominateDocsData.FluentValidation
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using DominateDocsSite.State


@rendermode InteractiveServer
@inject BrokerViewModel vm
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject BrokerValidator BrokerValidator
@inject SigningAuthorityValidator SigningAuthorityValidator
@inject EntityOwnerValidator EntityOwnerValidator
@inject AliasValidator AliasValidator
@inject UserSession Session
@inject Microsoft.JSInterop.IJSRuntime JS



<MudText class="pl-4 mt-5" Typo="Typo.h4">Broker Add/Edit</MudText>

@if (!String.IsNullOrEmpty(searchString))
{
    <MudText class="pl-4 mt-5" Typo="Typo.h6">Existing Brokers</MudText>
    <MudTable Items="FilteredList"
              Hover="true"
              Bordered="true"
              Dense="true"
              @bind-SelectedItem="vm.SelectedRecord"
              RowClick="OnSelectedRecord" T="DominateDocsData.Models.Broker">
        <ToolBarContent>
            <MudTextField @bind-Value="searchString"
                          Placeholder="Search..."
                          Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Entity Name</MudTh>
            <MudTh>Address</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>
                <MudButton Class="rounded-4"
                           Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="SearchBackAsync">
                    Back
                </MudButton>
            </MudTh>

        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Enitity Name">@context.EntityName</MudTd>
            <MudTd DataLabel="Address">@context.FullAddress</MudTd>
            <MudTd DataLabel="Phone">@context.ContactPhoneNumber</MudTd>
            <MudTd DataLabel="Email">@context.ContactEmail</MudTd>
            <MudTd DataLabel="Active">
                <MudChip T="bool" Color="@((context.IsActive) ? Color.Success : Color.Error)">
                    @(context.IsActive ? "Yes" : "No")
                </MudChip>
            </MudTd>
            <MudTd>

                <MudButton Class="rounded-4"
                           Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OnSelectedRecord(context))">
                    Add Broker
                </MudButton>


            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Color="Color.Secondary" Class="pa-4">
                🚫 No Active Brokers Found. Please add!
            </MudText>
        </NoRecordsContent>
    </MudTable>
}
else
{

    <MudTextField @bind-Value="searchString"
                  Placeholder="Search..."
                  Immediate="true" />

    <MudItem xs="12" Class="mt-3 mb-3 ml-5">
        <MudText Typo="Typo.h5">Broker</MudText>

    </MudItem>

    <MudForm Context="contextLender" Model="@vm.EditingRecord" @ref="@formEditRecord" Validation="@BrokerValidator" ValidationDelay="0">

        <MudGrid GutterSize="3">

            <MudItem md="4">

                <div class="d-flex flex-column gap-4">

                    <MudSelect Class="ml-4 mt-7" T="DominateDocsData.Enums.Entity.Types" Style="" Variant="Variant.Outlined" Label="Select Entity Type" @bind-Value="vm.EditingRecord.EntityType" Dense="true">

                        @foreach (var gt in Enum.GetValues<DominateDocsData.Enums.Entity.Types>())
                        {
                            <MudSelectItem Style="" T="DominateDocsData.Enums.Entity.Types" Value="gt">@gt.GetDescription()</MudSelectItem>
                        }

                    </MudSelect>

                    @if (vm.EditingRecord.EntityType == DominateDocsData.Enums.Entity.Types.Entity)
                    {
                        <MudTextField Class="pl-4" Style="" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.EntityName" For="@(() => vm.EditingRecord.EntityName)" Label="Entity Name" Required="true" />

                        <MudSelect Class="ml-4" T="DominateDocsData.Enums.Entity.Structures" Style="" Variant="Variant.Outlined" Label="Select Entity Structure" @bind-Value="vm.EditingRecord.EntityStructure" Dense="true">

                            @foreach (var gt in Enum.GetValues<DominateDocsData.Enums.Entity.Structures>())
                            {
                                <MudSelectItem Style="" T="DominateDocsData.Enums.Entity.Structures" Value="gt">@gt.GetDescription()</MudSelectItem>
                            }

                        </MudSelect>

                        <MudSelect Class="ml-4" T="DominateDocsData.Enums.UsStates.UsState" Style="" Variant="Variant.Outlined" Label="Select State of Incorporation" @bind-Value="vm.EditingRecord.StateOfIncorporation" Dense="true">

                            @foreach (var tr in Enum.GetValues<DominateDocsData.Enums.UsStates.UsState>())
                            {
                                <MudSelectItem Style="" T="DominateDocsData.Enums.UsStates.UsState" Value="tr">@tr.GetDescription()</MudSelectItem>
                            }

                        </MudSelect>


                        <MudTextField Class="pl-4" Style="" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.ContactName" For="@(() => vm.EditingRecord.ContactName)" Label="Contact Name" Required="true" />

                        <MudSelect Class="ml-4" T="DominateDocsData.Enums.Entity.ContactRoles" Style="" Variant="Variant.Outlined" Label="Contact's Role" @bind-Value="vm.EditingRecord.ContactsRole" Dense="true">

                            @foreach (var gt in Enum.GetValues<DominateDocsData.Enums.Entity.ContactRoles>())
                            {
                                <MudSelectItem Style="" T="DominateDocsData.Enums.Entity.ContactRoles" Value="gt">@gt.GetDescription()</MudSelectItem>
                            }

                        </MudSelect>


                        <MudTextField Class="pl-4"
                                      Style=""
                                      Variant="Variant.Outlined"
                                      @bind-Value="_contactEmail"
                                      @bind-Value:event="oninput"
                                      Label="Contact Email"
                                      Placeholder="example@domain.com"
                                      Required="true"
                                      RequiredError="Email is required"
                                      Pattern="@emailPattern"
                                      PatternErrorMessage="Invalid email format"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      InputId="@EmailInputId"
                                      OnBlur="OnContactFieldBlur" />


                        <MudTextField Label="Contact Phone"
                                      Class="pl-4"
                                      Style=""
                                      Variant="Variant.Outlined"
                                      @bind-Value="_contactPhoneNumber"
                                      @bind-Value:event="oninput"
                                      Placeholder="(___) ___-____"
                                      Required="true"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      InputId="@PhoneInputId"
                                      OnBlur="OnContactFieldBlur" />
                    }
                    else
                    {
                        <MudTextField Class="pl-4" Style="" Variant="Variant.Outlined" @bind-Value="vm.EditingRecord.ContactName" For="@(() => vm.EditingRecord.ContactName)" Label="ContactName" Required="true" />



                        <MudTextField Class="pl-4"
                                      Style=""
                                      Variant="Variant.Outlined"
                                      @bind-Value="_contactEmail"
                                      @bind-Value:event="oninput"
                                      Label="Contact Email"
                                      Placeholder="example@domain.com"
                                      Required="true"
                                      RequiredError="Email is required"
                                      Pattern="@emailPattern"
                                      PatternErrorMessage="Invalid email format"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      InputId="@EmailInputId"
                                      OnBlur="OnContactFieldBlur" />


                        <MudTextField Label="Contact Phone"
                                      Class="pl-4"
                                      Style=""
                                      Variant="Variant.Outlined"
                                      @bind-Value="_contactPhoneNumber"
                                      @bind-Value:event="oninput"
                                      Placeholder="(___) ___-____"
                                      Required="true"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      InputId="@PhoneInputId"
                                      OnBlur="OnContactFieldBlur" />

                        <MudTextField Class="pl-4 mr-5"
                                      @bind-Value="_ssn"
                                      @bind-Value:event="oninput"
                                      Style=""
                                      Variant="Variant.Outlined"
                                      For="@(() => vm.EditingRecord.SSN)"
                                      Label="SSN"
                                      Placeholder="___-__-____"
                                      Required="true"
                                      RequiredError="SSN is required"
                                      Pattern="^\\d{3}-\\d{2}-\\d{4}$"
                                      PatternErrorMessage="Invalid SSN format"
                                      Immediate="true"
                                      DebounceInterval="250"
                                      InputId="@SsnInputId"
                                      OnBlur="OnContactFieldBlur" />
                    }


                    <AddressCompleteMap OnAddressChange="OnAddressComplete" Row="false" MultipleAddress="false" AddressList="@addresDTOList" DisplayMap="false" />

                </div>
            </MudItem>
            <MudItem md="4">
                <div class="d-flex flex-column gap-4">

                    <MudNumericField Class="pl-4 mr-5 mt-7" Style="" HideSpinButtons="true" Culture="CultureInfo.InvariantCulture"
                                     Format="N2" @bind-Value="vm.EditingRecord.BrokerCommissionPercentage" Label="Commision %" Variant="Variant.Outlined" />

                    @if (vm.EditingRecord.EntityType == DominateDocsData.Enums.Entity.Types.Entity)
                    {
                        <EntityOwner OnEntityOwnerComplete="OnEntityOwnerComplete" OnEntityOwnerCanceled="OnEntityOwnerCanceled" OwnerList="@vm.EditingRecord.EntityOwners" />
                    }

                    <MudTextField Class="pl-4 mr-5" Variant="Variant.Outlined" Style="" @bind-Value="vm.EditingRecord.NmlsLicenseNumber" Color="Color.Primary" For="@(() => vm.EditingRecord.NmlsLicenseNumber)" Label="NMLS License Number" />

                    <MudSwitch Class="pl-4 pr-4" T="bool" @bind-Value="vm.EditingRecord.IsStateLicense" Color="Color.Primary">State Licenses(@(vm.EditingRecord.StateLicenses?.Count))</MudSwitch>

                    @if (vm.EditingRecord.IsStateLicense)
                    {
                        <StateLendingLicense OnStateLicenseComplete="OnStateLicenseComplete"
                                             OnStateLicenseCanceled="OnStateLicenseCanceled"
                                             StateLicenseList="@vm.EditingRecord.StateLicenses" />
                    }

                    <MudSwitch Class="pl-4 pr-4" T="bool" @bind-Value="vm.EditingRecord.IsAliasNamesUsed" Color="Color.Primary">Alias Names(@(vm.EditingRecord.AliasNames?.Count))</MudSwitch>

                    @if (vm.EditingRecord.IsAliasNamesUsed)
                    {
                        <AkaAlias OnAliasComplete="OnAliasComplete" OnAliasCanceled="OnAliasCanceled" AliasList="@vm.EditingRecord.AliasNames" />
                    }

                    <MudSwitch Class="pl-4 pr-4" T="bool" @bind-Value="vm.EditingRecord.IsSignatureAuthority" Color="Color.Primary">Signature Authority Names(@(vm.EditingRecord.SigningAuthorities?.Count))</MudSwitch>

                    @if (vm.EditingRecord.IsSignatureAuthority)
                    {
                        <SignatureAuthority OnSigningAuthorityComplete="OnSigningAuthorityComplete" OnSigningAuthorityCanceled="OnSigningAuthorityCanceled" SigningAuthorityList="@vm.EditingRecord.SigningAuthorities" />
                    }

                    <MudStack Row="true" Spacing="5" Class="mt-4">
                        <MudSwitch Class="pl-4" T="bool" @bind-Value="vm.EditingRecord.IsLanuageTranslatorRequired" Color="Color.Primary" Label="Requires Translator" />
                        <MudSwitch Class="pl-4" T="bool" @bind-Value="vm.EditingRecord.IsAForgeinNational" Color="Color.Primary" Label="Forgein National" />
                    </MudStack>
                </div>

                <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-4">
                    <MudItem md="3">
                        <MudButton Class="" Type="Submit" OnClick="HandleSubmit" Color="Color.Success" Variant="Variant.Filled"> @(!editRecord ? "Add" : "Save")</MudButton>
                    </MudItem>
                    <MudItem md="3">
                        <MudButton Class="" OnClick="ClearSelection" Color="Color.Secondary" Variant="Variant.Filled">Clear</MudButton>
                    </MudItem>
                </MudGrid>

            </MudItem>

        </MudGrid>
    </MudForm>
}

@code
{
    [Parameter] public EventCallback<DominateDocsData.Models.Broker> OnBrokerComplete { get; set; }
    [Parameter] public EventCallback OnBrokerCancel { get; set; }
    [Parameter] public bool AllowRecordEdit { get; set; } = false;
    [Parameter] public DominateDocsData.Models.Broker SelectedBroker { get; set; }

    private bool AddEdit = false;

    private bool editRecord = false;


    private MudForm formEditRecord;

    private List<AddressDTO> addresDTOList = new();

    private MudTable<DominateDocsData.Models.Broker> searchTable = new();

    private List<DominateDocsData.Models.Broker> searchList = new();

    private string searchString = "";

    private readonly PatternMask phoneMask = new("(000)000-0000");

    private readonly PatternMask socialMask = new("000-00-0000");

    private string emailPattern = @"^[\w\-\.]+@([\w\-]+\.)+[\w\-]{2,4}$";

    private bool AddButtonDisabled = false;

    // =========================
    // JS masking (client-side) fields
    // Keep input state in the component so re-renders (e.g., address selection) don't wipe what the user typed
    // before Blazor gets a chance to sync it.
    // =========================
    private const string PhoneInputId = "broker_contact_phone";
    private const string SsnInputId = "broker_contact_ssn";
    private const string EmailInputId = "broker_contact_email";

    private string? _contactPhoneNumber;
    private string? _ssn;
    private string? _contactEmail;

    private DominateDocsData.Enums.Entity.Types? _lastEntityTypeForMaskInit;

    protected override async Task OnInitializedAsync()
    {
        vm.InitializePageCommand.Execute(SelectedBroker);

        if (SelectedBroker is not null)
        {
            editRecord = true;
        }

        if (!String.IsNullOrEmpty(vm.EditingRecord.FullAddress))
        {
            AddressDTO dto = new()
            {
                FullAddress = vm.EditingRecord.FullAddress,
                StreetAddress = vm.EditingRecord.StreetAddress,
                City = vm.EditingRecord.City,
                ZipCode = vm.EditingRecord.ZipCode,
                State = vm.EditingRecord.State,
                County = vm.EditingRecord.County,
                Country = vm.EditingRecord.Country,
                Lat = vm.EditingRecord.Lat,
                Lng = vm.EditingRecord.Lng
            };
            addresDTOList.Add(dto);
        }

        SyncInputsFromModel();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Attach/refresh client-side masks. We do this after render because MudTextField renders an <input> we need to hook.
        var currentType = vm?.EditingRecord?.EntityType;

        if (firstRender || _lastEntityTypeForMaskInit != currentType)
        {
            _lastEntityTypeForMaskInit = currentType;

            try
            {
                await JS.InvokeVoidAsync("DominateDocsMasks.attachBrokerMasks", PhoneInputId, SsnInputId, EmailInputId);
            }
            catch
            {
                // If JS fails to attach, don't crash the page.
            }
        }
    }

    private IEnumerable<DominateDocsData.Models.Broker> FilteredList =>
      string.IsNullOrWhiteSpace(searchString)
          ? vm.RecordList
          : vm.RecordList.Where(l =>
                 (!string.IsNullOrEmpty(l.EntityName) &&
                  l.EntityName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
              || (!string.IsNullOrEmpty(l.FullAddress) &&
                  l.FullAddress.Contains(searchString, StringComparison.OrdinalIgnoreCase))
              || (!string.IsNullOrEmpty(l.ContactPhoneNumber) &&
                  l.ContactPhoneNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
              || (!string.IsNullOrEmpty(l.ContactEmail) &&
                  l.ContactEmail.Contains(searchString, StringComparison.OrdinalIgnoreCase)));

    private async Task AddBrokerForEditAsync(DominateDocsData.Models.Broker r)
    {
        if (AllowRecordEdit)
        {
            vm.EditingRecord = r;

            SyncInputsFromModel();

            editRecord = true;

            searchString = "";

            AddButtonDisabled = false;
        }

        StateHasChanged();
    }

    private async Task SearchBackAsync()
    {
        searchString = "";
    }

    private async Task HandleSubmit()
    {
        CommitInputsToModel();

        await formEditRecord.Validate();

        if (!formEditRecord.IsValid)
        {
            Snackbar.Add("Please correct the errors in the form.", Severity.Error);
            return;
        }
        else
        {
            if (!editRecord)
            {

                if (vm.RecordList.Any(x => (x.SSN == vm.EditingRecord.SSN && vm.EditingRecord.SSN != null) || (x.EIN == vm.EditingRecord.EIN && vm.EditingRecord.EIN != null)))
                {

                    Snackbar.Add("A Broker already exists choose from the list of Brokers.", Severity.Error);
                    return;
                }
            }

            vm.UpsertRecordCommand.Execute(null);

            await OnBrokerComplete.InvokeAsync(vm.EditingRecord);

            AddButtonDisabled = false;

            vm.GetNewRecordCommand.Execute(null);

            SyncInputsFromModel();

            StateHasChanged();
        }
    }

    private void ClearSelection()
    {
        vm.ClearSelectionCommand.Execute(null);

        SyncInputsFromModel();
    }

    private void AddButton()
    {
        vm.EditingRecord = new DominateDocsData.Models.Broker();
        vm.EditingRecord.Id = Guid.NewGuid();
        vm.EditingRecord.UserId = Session.UserId;

        SyncInputsFromModel();

        AddEdit = true;
        AddButtonDisabled = true;
    }

    private void OnSelectedRecord(DominateDocsData.Models.Broker r)
    {
        searchString = "";

        vm.SelectRecordCommand.Execute(r);

        SyncInputsFromModel();

        editRecord = true;

        AddEdit = true;
    }

    private void OnAddressComplete(List<AddressDTO> addressList)
    {
        if (addressList == null || addressList.Count == 0)
        {
            vm.EditingRecord.FullAddress = string.Empty;
            vm.EditingRecord.StreetAddress = string.Empty;
            vm.EditingRecord.State = string.Empty;
            vm.EditingRecord.City = string.Empty;
            vm.EditingRecord.ZipCode = string.Empty;
            vm.EditingRecord.County = string.Empty;
            vm.EditingRecord.Country = string.Empty;
        }
        else
        {
            var addressDTO = addressList.FirstOrDefault();

            vm.EditingRecord.FullAddress = addressDTO.FullAddress;
            vm.EditingRecord.StreetAddress = addressDTO.StreetAddress;
            vm.EditingRecord.State = addressDTO.State;
            vm.EditingRecord.City = addressDTO.City;
            vm.EditingRecord.ZipCode = addressDTO.ZipCode;
            vm.EditingRecord.County = addressDTO.County;
            vm.EditingRecord.Country = addressDTO.Country;
            vm.EditingRecord.Lat = addressDTO.Lat;
            vm.EditingRecord.Lng = addressDTO.Lng;
        }

        // Do NOT touch phone/email/ssn local state here; address selection triggers a re-render.
        // We keep those values in _contactPhoneNumber/_contactEmail/_ssn so they don't get wiped.
    }

    private async Task OnEntityOwnerComplete(List<DominateDocsData.Models.EntityOwner> entityOwners)
    {
        vm.EditingRecord.EntityOwners = entityOwners;
    }

    private async Task OnEntityOwnerCanceled()
    {
        StateHasChanged();
    }

    private async Task OnSigningAuthorityComplete(List<DominateDocsData.Models.SigningAuthority> signers)
    {
        vm.EditingRecord.SigningAuthorities = signers;
    }

    private async Task OnSigningAuthorityCanceled()
    {
        StateHasChanged();
    }

    private async Task OnAliasComplete(List<DominateDocsData.Models.AkaName> alias)
    {
        vm.EditingRecord.AliasNames = alias;
    }

    private async Task OnAliasCanceled()
    {
        StateHasChanged();
    }

    private async Task OnStateLicenseComplete(List<DominateDocsData.Models.StateLendingLicense> r)
    {
        vm.EditingRecord.StateLicenses = r;
    }

    private async Task OnStateLicenseCanceled()
    {

    }

    private void SyncInputsFromModel()
    {
        _contactPhoneNumber = vm?.EditingRecord?.ContactPhoneNumber;
        _ssn = vm?.EditingRecord?.SSN;
        _contactEmail = vm?.EditingRecord?.ContactEmail;
    }

    private void CommitInputsToModel()
    {
        if (vm?.EditingRecord is null)
            return;

        vm.EditingRecord.ContactPhoneNumber = NormalizePhone(_contactPhoneNumber);
        vm.EditingRecord.SSN = NormalizeSsn(_ssn);
        vm.EditingRecord.ContactEmail = NormalizeEmail(_contactEmail);

        // Keep local fields aligned with whatever normalization we applied.
        _contactPhoneNumber = vm.EditingRecord.ContactPhoneNumber;
        _ssn = vm.EditingRecord.SSN;
        _contactEmail = vm.EditingRecord.ContactEmail;
    }

    private Task OnContactFieldBlur(FocusEventArgs _)
    {
        CommitInputsToModel();
        return Task.CompletedTask;
    }

    private static string? NormalizeEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return email;

        // Strip spaces and trim; do NOT force lower-case unless you explicitly want that behavior.
        var v = email.Replace(" ", string.Empty, StringComparison.Ordinal).Trim();
        return v;
    }

    private static string? NormalizePhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return phone;

        // Keep only digits, then format as (###) ###-#### when possible
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length == 0)
            return string.Empty;

        if (digits.Length > 10)
            digits = digits.Substring(0, 10);

        if (digits.Length < 4)
            return "(" + digits;

        if (digits.Length < 7)
            return "(" + digits.Substring(0, 3) + ") " + digits.Substring(3);

        return "(" + digits.Substring(0, 3) + ") " + digits.Substring(3, 3) + "-" + digits.Substring(6);
    }

    private static string? NormalizeSsn(string? ssn)
    {
        if (string.IsNullOrWhiteSpace(ssn))
            return ssn;

        var digits = new string(ssn.Where(char.IsDigit).ToArray());
        if (digits.Length == 0)
            return string.Empty;

        if (digits.Length > 9)
            digits = digits.Substring(0, 9);

        if (digits.Length < 4)
            return digits;

        if (digits.Length < 6)
            return digits.Substring(0, 3) + "-" + digits.Substring(3);

        return digits.Substring(0, 3) + "-" + digits.Substring(3, 2) + "-" + digits.Substring(5);
    }

}

<script>
    // Client-side masking to avoid Blazor Server / SignalR caret chaos on Azure.
    // We still update the component as the user types (debounced), but formatting stays in the browser.
    window.DominateDocsMasks = window.DominateDocsMasks || {};

    window.DominateDocsMasks.attachBrokerMasks = function (phoneId, ssnId, emailId) {
        try {
            attachPhone(phoneId);
            attachSSN(ssnId);
            attachEmail(emailId);
        } catch (e) {
            console.error("DominateDocsMasks.attachBrokerMasks failed:", e);
        }
    };

    function onlyDigits(s) {
        return (s || "").replace(/\D+/g, "");
    }

    function formatPhone(d) {
        d = (d || "").slice(0, 10);
        if (d.length === 0) return "";
        if (d.length < 4) return "(" + d;
        if (d.length < 7) return "(" + d.slice(0, 3) + ") " + d.slice(3);
        return "(" + d.slice(0, 3) + ") " + d.slice(3, 6) + "-" + d.slice(6);
    }

    function formatSSN(d) {
        d = (d || "").slice(0, 9);
        if (d.length === 0) return "";
        if (d.length < 4) return d;
        if (d.length < 6) return d.slice(0, 3) + "-" + d.slice(3);
        return d.slice(0, 3) + "-" + d.slice(3, 5) + "-" + d.slice(5);
    }

    function markAttached(el, key) {
        const k = "ddMask_" + key;
        if (el.dataset[k] === "1") return true;
        el.dataset[k] = "1";
        return false;
    }

    function notifyBlazor(el) {
        // MudTextField listens for input events.
        el.dispatchEvent(new Event("input", { bubbles: true }));
    }

    function attachPhone(id) {
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        if (markAttached(el, "phone")) return;

        el.setAttribute("inputmode", "tel");
        el.setAttribute("autocomplete", "tel");

        let formatting = false;

        const apply = (shouldNotify) => {
            if (formatting) return;
            formatting = true;
            try {
                const before = el.value;
                const d = onlyDigits(before);
                const after = formatPhone(d);
                if (before !== after) {
                    el.value = after;
                }
                if (shouldNotify) notifyBlazor(el);
            } finally {
                formatting = false;
            }
        };

        el.addEventListener("input", () => apply(false));
        el.addEventListener("change", () => apply(true)); // autofill / browser cache often triggers change
        el.addEventListener("blur", () => apply(true));

        apply(true);
    }

    function attachSSN(id) {
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        if (markAttached(el, "ssn")) return;

        el.setAttribute("inputmode", "numeric");
        el.setAttribute("autocomplete", "off");

        let formatting = false;

        const apply = (shouldNotify) => {
            if (formatting) return;
            formatting = true;
            try {
                const before = el.value;
                const d = onlyDigits(before);
                const after = formatSSN(d);
                if (before !== after) {
                    el.value = after;
                }
                if (shouldNotify) notifyBlazor(el);
            } finally {
                formatting = false;
            }
        };

        el.addEventListener("input", () => apply(false));
        el.addEventListener("change", () => apply(true));
        el.addEventListener("blur", () => apply(true));

        apply(true);
    }

    function attachEmail(id) {
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        if (markAttached(el, "email")) return;

        el.setAttribute("inputmode", "email");
        el.setAttribute("autocomplete", "email");

        let cleaning = false;

        const sanitize = (shouldNotify) => {
            if (cleaning) return;
            cleaning = true;
            try {
                const before = el.value || "";
                const after = before.replace(/\s+/g, "").trim();
                if (before !== after) {
                    el.value = after;
                }
                if (shouldNotify) notifyBlazor(el);
            } finally {
                cleaning = false;
            }
        };

        el.addEventListener("keydown", (e) => {
            if (e.key === " ") e.preventDefault();
        });

        el.addEventListener("input", () => sanitize(false));
        el.addEventListener("change", () => sanitize(true));
        el.addEventListener("blur", () => sanitize(true));

        sanitize(true);
    }
</script>
