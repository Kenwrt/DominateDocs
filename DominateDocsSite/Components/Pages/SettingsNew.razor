@page "/settingsnew"

@using DominateDocsSite.Components.Shared
@using DominateDocsSite.Models
@using DominateDocsSite.Models.Enums
@using DominateDocsSite.ViewModels

@inject SettingsViewModelNew VM

<PageTitle>Dominate Docs — Settings</PageTitle>

<div class="d-flex" style="min-height:calc(100vh - 120px);margin:-24px -32px;">

    @* ── Wizard Sidebar ── *@
    <div style="width:280px;flex-shrink:0;background:white;border-right:1px solid #e2e8f0;padding:32px 24px;">
        <MudText Style="font-family:'Outfit';font-size:20px;font-weight:700;color:#0f2b4a;">Default Profile</MudText>
        <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-8">Set once, use everywhere. Override per deal.</MudText>

        <MudText Typo="Typo.overline" Style="letter-spacing:1.2px;color:#94a3b8;font-weight:600;" Class="mb-4">Setup Steps</MudText>

        @for (var i = 0; i < SettingsViewModelNew.Steps.Length; i++)
        {
            var idx = i;
            var step = SettingsViewModelNew.Steps[idx];
            var isActive = VM.CurrentStep == idx;
            var isComplete = idx < VM.CurrentStep;

            <div class="d-flex align-start gap-3 pa-3 rounded-lg mb-1 cursor-pointer"
                 style="@($"background:{(isActive ? "#e0f2fe" : "transparent")};transition:all 0.2s;")"
                 @onclick="@(() => VM.GoToStep(idx))">
                <MudAvatar Size="Size.Small" Style="@($"width:28px;height:28px;font-size:12px;font-weight:700;{(isComplete ? "background:#10b981;color:white;" : isActive ? "background:#0ea5e9;color:white;" : "background:transparent;border:2px solid #e2e8f0;color:#94a3b8;")}")">
                    @if (isComplete)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:14px;" />
                    }
                    else
                    {
                        @(idx + 1)
                    }
                </MudAvatar>
                <div>
                    <MudText Style="@($"font-size:14px;font-weight:600;color:{(isActive ? "#0284c7" : "#0f172a")};line-height:1.3;")">
                        @step.Title
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#94a3b8;">@step.Desc</MudText>
                </div>
            </div>
        }
    </div>

    @* ── Wizard Main ── *@
    <div style="flex:1;padding:40px 48px;max-width:900px;">

        @* Progress bar *@
        <div class="mb-8">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.overline" Style="font-weight:600;color:#94a3b8;letter-spacing:0.8px;">
                    @VM.ProgressLabel
                </MudText>
                <MudText Typo="Typo.caption" Style="font-weight:700;color:#0ea5e9;">@(VM.ProgressPercent)%</MudText>
            </div>
            <MudProgressLinear Value="@VM.ProgressPercent" Color="Color.Primary" Rounded="true" Size="Size.Small"
                               Style="background:#e2e8f0;" />
        </div>

        @* ═══ STEP 1: Your Details ═══ *@
        @if (VM.CurrentStep == 0)
        {
            <MudText Typo="Typo.h4" Style="font-family:'Outfit';color:#0f2b4a;letter-spacing:-0.5px;margin-bottom:6px;">
                Your Details
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#475569;" Class="mb-6">
                Tell us about your role and entity. This auto-fills across every deal.
            </MudText>

            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-6"
                      Style="background:linear-gradient(135deg,#0f2b4a,#1e3a5f);border-radius:8px;">
                <b>Tip:</b> These defaults pre-fill every new loan. You can always override them per deal.
            </MudAlert>

            @* Role Selection *@
            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">What's your role?</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-4">This determines your default fields and document packages.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var role in Enum.GetValues<UserRole>())
                    {
                        var selected = VM.Profile.Role == role;
                        <MudItem xs="6" sm="3">
                            <MudPaper Class="pa-5 text-center cursor-pointer"
                                      Style="@($"border:2px solid {(selected ? "#0ea5e9" : "#e2e8f0")};border-radius:12px;background:{(selected ? "#f0f9ff" : "white")};transition:all 0.2s;")"
                                      @onclick="@(() => VM.SelectRole(role))" Elevation="0">
                                <MudIcon Icon="@GetRoleIcon(role)" Style="@($"font-size:24px;color:{(selected ? "#0ea5e9" : "#64748b")};margin-bottom:8px;")" />
                                <MudText Style="font-size:14px;font-weight:600;color:#0f172a;">@role</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            @* Entity Information *@
            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">Entity Information</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-5">Your lending entity details for document generation.</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="EntityType" Label="Entity Type" Variant="Variant.Outlined" @bind-Value="VM.Profile.EntityOrIndividual">
                            @foreach (var et in Enum.GetValues<EntityType>())
                            { <MudSelectItem Value="et">@et.ToDisplayString()</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="EntityStructure" Label="Entity Structure" Variant="Variant.Outlined" @bind-Value="VM.Profile.EntityStructure">
                            @foreach (var es in Enum.GetValues<EntityStructure>())
                            { <MudSelectItem Value="es">@es.ToDisplayString()</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Entity Name" Variant="Variant.Outlined" @bind-Value="VM.Profile.EntityName" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="State of Incorporation" Variant="Variant.Outlined" @bind-Value="VM.Profile.StateOfIncorporation">
                            @foreach (var s in Constants.USStates)
                            { <MudSelectItem Value="s">@s</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="EIN" Variant="Variant.Outlined" @bind-Value="VM.Profile.EIN" Placeholder="XX-XXXXXXX" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Address" Variant="Variant.Outlined" @bind-Value="VM.Profile.EntityAddress" Placeholder="Start typing an address..." />
                    </MudItem>
                </MudGrid>

                @* Contact Person Divider *@
                <div class="d-flex align-center gap-3 my-6">
                    <MudDivider FlexItem="true" />
                    <MudText Typo="Typo.overline" Style="color:#94a3b8;white-space:nowrap;letter-spacing:1.2px;font-weight:700;">Contact Person</MudText>
                    <MudDivider FlexItem="true" />
                </div>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Contact Name" Variant="Variant.Outlined" @bind-Value="VM.Profile.ContactName" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Contact Role" Variant="Variant.Outlined" @bind-Value="VM.Profile.ContactRole">
                            @foreach (var t in Constants.SignatoryTitles)
                            { <MudSelectItem Value="t">@t</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="VM.Profile.ContactEmail"
                                      Required="true" InputType="InputType.Email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Phone" Variant="Variant.Outlined" @bind-Value="VM.Profile.ContactPhone"
                                      Required="true" InputType="InputType.Telephone" />
                    </MudItem>
                </MudGrid>

                @* Licenses *@
                <div class="mt-5">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <div class="d-flex align-center gap-2">
                            <MudText Style="font-size:13px;font-weight:600;color:#475569;">State Lending Licenses</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                     Style="font-size:11px;min-height:20px;height:20px;">@VM.Profile.Licenses.Count</MudChip>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="VM.AddLicense"
                                   Style="text-transform:none;font-size:12px;border-style:dashed;">Add License</MudButton>
                    </div>
                    @if (VM.Profile.Licenses.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Hover="true" Style="border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;">
                            <thead>
                                <tr>
                                    <th style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#94a3b8;">State</th>
                                    <th style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#94a3b8;">License Number</th>
                                    <th style="width:120px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#94a3b8;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < VM.Profile.Licenses.Count; i++)
                                {
                                    var idx = i;
                                    var lic = VM.Profile.Licenses[idx];
                                    <tr>
                                        <td>
                                            <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="lic.State" Dense="true">
                                                @foreach (var s in Constants.USStates)
                                                { <MudSelectItem Value="s">@s</MudSelectItem> }
                                            </MudSelect>
                                        </td>
                                        <td>
                                            <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="lic.Number" />
                                        </td>
                                        <td>
                                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                                       OnClick="@(() => VM.RemoveLicense(idx))" Style="text-transform:none;font-size:11px;">Delete</MudButton>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            </MudPaper>

            <SettingsFooter VM="VM" ShowBack="false" />
        }

        @* ═══ STEP 2: Loan Basics ═══ *@
        @if (VM.CurrentStep == 1)
        {
            <MudText Typo="Typo.h4" Style="font-family:'Outfit';color:#0f2b4a;letter-spacing:-0.5px;margin-bottom:6px;">
                Loan Basics
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#475569;" Class="mb-6">
                Pick your most common loan type. This pre-selects your default on every new deal.
            </MudText>

            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-6"
                      Style="background:linear-gradient(135deg,#0f2b4a,#1e3a5f);border-radius:8px;">
                <b>Do multiple types?</b> Pick your most frequent. You'll always be able to switch per deal.
            </MudAlert>

            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">What's your default loan type?</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-5">Select the loan product you originate most often.</MudText>
                <MudGrid Spacing="3">
                    @foreach (var lt in Enum.GetValues<DominateDocsSite.Models.Enums.LoanType>())
                    {
                        var selected = VM.Profile.DefaultLoanType == lt;
                        <MudItem xs="12" sm="4">
                            <MudPaper Class="pa-5 text-center cursor-pointer" Style="@($"border:2px solid {(selected ? "#0ea5e9" : "#e2e8f0")};border-radius:12px;background:{(selected ? "#f0f9ff" : "white")};transition:all 0.2s;position:relative;")"
                                      @onclick="@(() => VM.SelectDefaultLoanType(lt))" Elevation="0">
                                @if (selected)
                                {
                                    <MudAvatar Size="Size.Small" Style="position:absolute;top:10px;right:12px;width:22px;height:22px;background:#0ea5e9;font-size:11px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:14px;" />
                                    </MudAvatar>
                                }
                                <MudText Style="font-size:22px;margin-bottom:8px;">@GetLoanIcon(lt)</MudText>
                                <MudText Style="font-size:14px;font-weight:700;color:#0f172a;">@lt.ToDisplayString()</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <SettingsFooter VM="VM" />
        }

        @* ═══ STEP 3: User Defaults ═══ *@
        @if (VM.CurrentStep == 2)
        {
            <MudText Typo="Typo.h4" Style="font-family:'Outfit';color:#0f2b4a;letter-spacing:-0.5px;margin-bottom:6px;">
                User Defaults
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#475569;" Class="mb-6">
                Toggle the features and documents you typically include. These pre-check on every new deal.
            </MudText>

            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-6"
                      Style="background:linear-gradient(135deg,#0f2b4a,#1e3a5f);border-radius:8px;">
                <b>How this works:</b> Enabled features will be pre-selected on every new deal. Disabled ones won't appear unless you turn them on per deal.
            </MudAlert>

            @* Loan Features *@
            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">Loan Features</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-4">
                    Features you typically include on your deals. Toggle on = pre-selected by default.
                </MudText>

                <FeatureToggle Label="Prepayment Penalty" Hint="Penalty structure for early payoff"
                               Icon="@Icons.Material.Filled.CreditCard" @bind-Value="VM.Profile.DefaultFeatures.PrepaymentPenalty" />
                <FeatureToggle Label="Conditional Extension Right" Hint="Allow borrower to extend the loan term"
                               Icon="@Icons.Material.Filled.Schedule" @bind-Value="VM.Profile.DefaultFeatures.ConditionalExtension" />
                <FeatureToggle Label="Partial Release Clause" Hint="Allow release of individual collateral parcels"
                               Icon="@Icons.Material.Filled.GridView" @bind-Value="VM.Profile.DefaultFeatures.PartialRelease" />
                <FeatureToggle Label="Exit Fee" Hint="Fee upon loan payoff"
                               Icon="@Icons.Material.Filled.ExitToApp" @bind-Value="VM.Profile.DefaultFeatures.ExitFee" />
                <FeatureToggle Label="Termination Fee" Hint="Fee charged if loan is terminated early"
                               Icon="@Icons.Material.Filled.Cancel" @bind-Value="VM.Profile.DefaultFeatures.TerminationFee" />
                <FeatureToggle Label="ACH Payments Required" Hint="Enable automated electronic payments"
                               Icon="@Icons.Material.Filled.AccountBalance" @bind-Value="VM.Profile.DefaultFeatures.ACHPaymentsRequired" />
                <FeatureToggle Label="MERS Language" Hint="Mortgage Electronic Registration System"
                               Icon="@Icons.Material.Filled.Description" @bind-Value="VM.Profile.DefaultFeatures.MERSLanguage" />
            </MudPaper>

            @* Document Delivery *@
            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">Document Delivery</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-5">How would you like your generated loan packages delivered?</MudText>
                <MudGrid Spacing="3" Class="mb-4">
                    @foreach (var (value, label, desc, icon) in _deliveryOptions)
                    {
                        var selected = VM.Profile.DeliveryMethod == value;
                        <MudItem xs="12" sm="4">
                            <MudPaper Class="pa-4 text-center cursor-pointer" Style="@($"border:2px solid {(selected ? "#0ea5e9" : "#e2e8f0")};border-radius:12px;background:{(selected ? "#f0f9ff" : "white")};transition:all 0.2s;position:relative;")"
                                      @onclick="@(() => VM.Profile.DeliveryMethod = value)" Elevation="0">
                                @if (selected)
                                {
                                    <MudAvatar Size="Size.Small" Style="position:absolute;top:10px;right:12px;width:22px;height:22px;background:#0ea5e9;font-size:11px;">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:14px;" />
                                    </MudAvatar>
                                }
                                <MudIcon Icon="@icon" Style="color:#64748b;margin-bottom:8px;" />
                                <MudText Style="font-size:14px;font-weight:700;color:#0f172a;">@label</MudText>
                                <MudText Typo="Typo.caption" Style="color:#94a3b8;">@desc</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
                @if (VM.Profile.DeliveryMethod != "download")
                {
                    <MudPaper Class="pa-4" Elevation="0" Style="background:#f6f8fb;border-radius:8px;">
                        <MudTextField T="string" Label="Delivery Email" Variant="Variant.Outlined" @bind-Value="VM.Profile.DeliveryEmail" />
                        <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mt-2">
                            Documents will be sent here after every generation. You can add CC recipients per deal.
                        </MudText>
                    </MudPaper>
                }
            </MudPaper>

            @* Document Preferences *@
            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">Document Preferences</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-4">
                    Control which optional documents are included by default in your loan packages.
                </MudText>
                <MudPaper Class="pa-4" Elevation="0" Style="background:#f6f8fb;border-radius:8px;">
                    <DocPreference Label="W-9 Form" Note="IRS tax identification form for borrower" @bind-Included="VM.Profile.W9Included" />
                    <MudDivider Class="my-2" />
                    <DocPreference Label="Ownership Interest Pledge Agreement" Note="Pledge of borrower's ownership interest as additional collateral" @bind-Included="VM.Profile.OwnershipPledgeIncluded" />
                </MudPaper>
            </MudPaper>

            <SettingsFooter VM="VM" />
        }

        @* ═══ STEP 4: Billing ═══ *@
        @if (VM.CurrentStep == 3)
        {
            <MudText Typo="Typo.h4" Style="font-family:'Outfit';color:#0f2b4a;letter-spacing:-0.5px;margin-bottom:6px;">
                Billing Details
            </MudText>
            <MudText Typo="Typo.body2" Style="color:#475569;" Class="mb-6">
                Your account status and subscription information.
            </MudText>

            <MudPaper Class="pa-6 mb-5" Elevation="0" Style="border:1px solid #e2e8f0;border-radius:12px;">
                <MudText Style="font-size:16px;font-weight:700;color:#0f2b4a;margin-bottom:4px;">Account Status</MudText>
                <MudText Typo="Typo.caption" Style="color:#94a3b8;" Class="mb-5">Your current billing and subscription details.</MudText>

                @* Status banner *@
                <MudPaper Class="pa-4 d-flex align-center gap-4 mb-5" Elevation="0"
                          Style="background:linear-gradient(135deg,#ecfdf5,#d1fae5);border-radius:10px;border:1px solid rgba(16,185,129,0.2);">
                    <MudAvatar Rounded="true" Style="background:#10b981;width:44px;height:44px;">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </MudAvatar>
                    <div>
                        <MudText Style="font-size:15px;font-weight:700;color:#065f46;">Account Active</MudText>
                        <MudText Typo="Typo.caption" Style="color:#047857;">Subscription OK — All features enabled</MudText>
                    </div>
                </MudPaper>

                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Plan" Variant="Variant.Outlined" Value="@VM.Profile.Plan" Disabled="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Valid Until" Variant="Variant.Outlined" Value="@ken" Disabled="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Billing Email" Variant="Variant.Outlined" @bind-Value="VM.Profile.BillingEmail" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Payment Method" Variant="Variant.Outlined"
                                      Value="@($"•••• •••• •••• {VM.Profile.PaymentMethodLast4}")" Disabled="true" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* Footer with Save *@
            <div class="d-flex justify-space-between align-center mt-9 pt-6" style="border-top:1px solid #e2e8f0;">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Style="color:#10b981;font-size:8px;" />
                    <MudText Typo="Typo.caption" Style="color:#10b981;font-weight:500;">Auto-saved</MudText>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" OnClick="VM.PrevStep"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Style="text-transform:none;font-weight:600;">Back</MudButton>
                    <MudButton Variant="Variant.Filled" Color="@(VM.Saved ? Color.Success : Color.Primary)"
                               OnClick="VM.Save" StartIcon="@Icons.Material.Filled.CheckCircle"
                               Style="text-transform:none;font-weight:600;">
                        @(VM.Saved ? "Saved!" : "Save Profile")
                    </MudButton>
                </div>
            </div>
        }
    </div>
</div>

@code {

    private string ken = "ken";

    private static string GetLoanIcon(DominateDocsSite.Models.Enums.LoanType t) => t switch
    {
        DominateDocsSite.Models.Enums.LoanType.Bridge => "🏗️",
        DominateDocsSite.Models.Enums.LoanType.DSCR => "🏘️",
        DominateDocsSite.Models.Enums.LoanType.Multifamily => "🏢",
        DominateDocsSite.Models.Enums.LoanType.Commercial => "🏬",
        DominateDocsSite.Models.Enums.LoanType.Land => "🌄",
        _ => "📄"
    };

    private static string GetRoleIcon(UserRole r) => r switch
    {
        UserRole.Lender => Icons.Material.Filled.AccountBalance,
        UserRole.Broker => Icons.Material.Filled.People,
        UserRole.Servicer => Icons.Material.Filled.CheckBox,
        UserRole.Other => Icons.Material.Filled.Help,
        _ => Icons.Material.Filled.Help
    };

    private static readonly (string Value, string Label, string Desc, string Icon)[] _deliveryOptions =
    [
        ("both", "Download & Email", "Instant download + emailed copy", Icons.Material.Filled.CloudDownload),
        ("download", "Download Only", "Download immediately", Icons.Material.Filled.Download),
        ("email", "Email Only", "Sent to your account email", Icons.Material.Filled.Email)
    ];
}
