﻿@using DominateDocsData.Models
@using DominateDocsData.Models.DTOs
@using DominateDocsData.Models.RulesEngine
@using MudBlazor
@using System.Reflection

@inject LoanTypeViewModel vm
@inject IDialogService DialogService
@inject NavigationManager Nav

<style>
    /* Loan Type Create page polish */
    .loan-type-create .mud-breadcrumbs {
        margin-bottom: 12px;
    }

    /* Make the breadcrumb items feel clickable and consistent */
    .loan-type-create .mud-breadcrumb-item a {
        text-decoration: none;
        font-weight: 600;
    }

    .loan-type-create .mud-breadcrumb-item a:hover {
        text-decoration: underline;
    }

    .loan-type-create .section-title {
        font-weight: 700;
        letter-spacing: .2px;
    }

    .loan-type-create .subtle {
        color: rgba(0,0,0,.6);
    }

    .loan-type-create .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .loan-type-create .header-row .left {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .loan-type-create .header-row .right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .loan-type-create .default-docs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .loan-type-create .icon-preview {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .loan-type-create .icon-preview .label {
        font-size: .85rem;
        color: rgba(0,0,0,.6);
        margin-right: 6px;
    }

    .loan-type-create .icon-preview .preview {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,.04);
    }
</style>

<div class="loan-type-create">

    <MudBreadcrumbs Class="mb-2">
        <MudBreadcrumbItem Href="/LoanTypeList">Loan Types</MudBreadcrumbItem>
        <MudBreadcrumbItem Disabled="true">@((SelectedLoanType is null) ? "Create" : "Edit")</MudBreadcrumbItem>
    </MudBreadcrumbs>

    <div class="header-row mb-3">
        <div class="left">
            <MudText Typo="Typo.h5" Class="section-title">Loan Type</MudText>
            <MudText Typo="Typo.body2" Class="subtle">
                Define the loan type basics (name, description, icon), then configure rules.
            </MudText>
        </div>

        <div class="right">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@SaveDisabled"
                       OnClick="@Complete">
                Save
            </MudButton>
        </div>
    </div>

    <!-- Loan Type Details -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Loan Type Details</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudTextField Label="Name"
                              Variant="Variant.Outlined"
                              Dense="true"
                              @bind-Value="vm.EditingLoanType.Name"
                              Required="true" />
            </MudItem>

            <MudItem xs="12" md="5">
                <MudTextField Label="Description"
                              Variant="Variant.Outlined"
                              Dense="true"
                              @bind-Value="vm.EditingLoanType.Description" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudSelect T="string"
                           Label="Icon"
                           Variant="Variant.Outlined"
                           Dense="true"
                           @bind-Value="vm.EditingLoanType.IconKey">
                    @foreach (var option in IconOptions)
                    {
                        <MudSelectItem Value="@option.Key">@option.Icon</MudSelectItem>
                    }
                </MudSelect>

                <div class="icon-preview mt-2">
                    <span class="label">Preview:</span>
                    <span class="preview">
                        <MudIcon Icon="@vm.EditingLoanType.IconKey" />
                    </span>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="section-title">Loan Type Rules</MudText>

    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Configure which documents generate by default and which generate conditionally.
    </MudText>

    <!-- Default Documents -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
        <div class="d-flex align-center justify-space-between mb-2">
            <MudText Typo="Typo.subtitle2">Default Documents</MudText>

            <div class="d-flex align-center" style="gap:10px;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@OpenDefaultDocsPicker">
                    Select Documents
                </MudButton>

                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@RemoveAllLogic">
                    Remove all logic
                </MudButton>
            </div>
        </div>

        <div class="default-docs">
            @foreach (var id in (vm.EditingLoanType.DefaultDocumentIds ?? new List<Guid>()))
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Closeable="true"
                         OnClose="@(() => RemoveDefaultDoc(id))">
                    @GetDocNameById(id)
                </MudChip>
            }
        </div>
    </MudPaper>

    <!-- Output Rules -->
    @foreach (var rule in vm.OutputRulesUi)
    {
        var r = rule; // stable capture
        <OutputRuleEditor @key="r"
                          Rule="r"
                          MasterDocumentDTOs="vm.MasterDocumentDtos"
                          Fields="vm.Fields"
                          FieldValues="vm.FieldValues"
                          OnChanged="OnRulesChanged"
                          OnRemoveRequested="@(() => RemoveRule(r))" />
    }

    <div class="d-flex align-center mt-3" style="gap:10px;">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                   OnClick="@AddRule">
            Add output rule
        </MudButton>

        <MudSpacer />

        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="@Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   Disabled="@SaveDisabled"
                   OnClick="@Complete">
            Save
        </MudButton>
    </div>

</div>

@code {
    [Parameter] public EventCallback<LoanType> OnLoanTypeComplete { get; set; }
    [Parameter] public EventCallback OnLoanTypeCancel { get; set; }
    [Parameter] public LoanTypeListDTO? SelectedLoanType { get; set; }

    private static readonly IReadOnlyList<(string Key, string Icon)> IconOptions = BuildIconOptions();

    private bool SaveDisabled => string.IsNullOrWhiteSpace(vm.EditingLoanType.Name);

    protected override void OnParametersSet()
    {
        var selectedId = TryGetGuid(SelectedLoanType, "Id", "LoanTypeId", "_id");

        if (selectedId.HasValue && selectedId.Value != Guid.Empty)
            vm.LoadForEdit(selectedId.Value);
        else
            vm.LoadForCreate();

        vm.EnsureLogic();
        SyncUiToModel();
    }

    private async Task AddRule()
    {
        vm.AddOutputRule();
        SyncUiToModel();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveRule(OutputRule rule)
    {
        // Some view-model implementations rehydrate/clamp rules, which can make a "delete" look like it did nothing.
        // Remove it from the UI list first (source of truth for the editor), then sync back to the model.
        if (vm.OutputRulesUi is System.Collections.Generic.IList<OutputRule> list)
        {
            list.Remove(rule);
        }
        else
        {
            vm.RemoveOutputRule(rule);
        }

        SyncUiToModel();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveAllLogic()
    {
        vm.ClearAllLogic();

        // Also clear the UI list so the editor actually collapses immediately.
        if (vm.OutputRulesUi is System.Collections.Generic.IList<OutputRule> list)
            list.Clear();

        SyncUiToModel();
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveDefaultDoc(Guid id)
    {
        vm.EditingLoanType.DefaultDocumentIds ??= new List<Guid>();
        vm.EditingLoanType.DefaultDocumentIds.Remove(id);
    }

    private void AddDefaultDoc(Guid id)
    {
        if (id == Guid.Empty) return;

        vm.EditingLoanType.DefaultDocumentIds ??= new List<Guid>();
        if (!vm.EditingLoanType.DefaultDocumentIds.Contains(id))
            vm.EditingLoanType.DefaultDocumentIds.Add(id);
    }

    private void OpenDefaultDocsPicker()
    {
        vm.EditingLoanType.DefaultDocumentIds ??= new List<Guid>();
        var selected = new HashSet<Guid>(vm.EditingLoanType.DefaultDocumentIds);

        var parameters = new DialogParameters
        {
            ["Title"] = "Select Default Documents",
            ["AllDocuments"] = vm.MasterDocumentDtos,
            ["SelectedIds"] = selected,
            ["OnSelected"] = (Action<Guid>)((id) =>
            {
                AddDefaultDoc(id);
                InvokeAsync(StateHasChanged);
            })
        };

        var options = new DialogOptions { CloseButton = false, FullWidth = true, MaxWidth = MaxWidth.Medium };
        DialogService.Show<DocumentPickerDialog>("Select Documents", parameters, options);
    }

    private Task OnRulesChanged()
    {
        SyncUiToModel();
        return Task.CompletedTask;
    }

    private void SyncUiToModel()
    {
        vm.EditingLoanType.OutputRules ??= new List<OutputRule>();
        vm.EditingLoanType.OutputRules = vm.OutputRulesUi.ToList();
    }

    private async Task Complete()
    {
        if (string.IsNullOrWhiteSpace(vm.EditingLoanType.Name))
            return;

        var saved = vm.EditingLoanType;
        vm.CommitUiToModel();

        if (OnLoanTypeComplete.HasDelegate)
            await OnLoanTypeComplete.InvokeAsync(saved);
    }

    private async Task Cancel()
    {
        if (OnLoanTypeCancel.HasDelegate)
            await OnLoanTypeCancel.InvokeAsync();

        Nav.NavigateTo("/LoanTypeList");
    }

    private static Guid? TryGetGuid(object? obj, params string[] propertyNames)
    {
        if (obj is null) return null;

        var t = obj.GetType();
        foreach (var name in propertyNames)
        {
            var p = t.GetProperty(name, BindingFlags.Public | BindingFlags.Instance);
            if (p is null) continue;

            var val = p.GetValue(obj);
            if (val is Guid g) return g;
            if (val is string s && Guid.TryParse(s, out var parsed)) return parsed;
        }

        return null;
    }

    private string GetDocNameById(Guid id)
    {
        var match = vm.MasterDocumentDtos?.FirstOrDefault(d => d.Id == id);
        return match?.Name ?? id.ToString();
    }

    private static IReadOnlyList<(string Key, string Icon)> BuildIconOptions()
    {
        // Keep it simple: list common MudBlazor icons by string value.
        return new List<(string Key, string Icon)>
        {
            (Icons.Material.Filled.AccountCircle, "AccountCircle"),
            (Icons.Material.Filled.Business, "Business"),
            (Icons.Material.Filled.Description, "Description"),
            (Icons.Material.Filled.Gavel, "Gavel"),
            (Icons.Material.Filled.Home, "Home"),
            (Icons.Material.Filled.Person, "Person"),
            (Icons.Material.Filled.RequestQuote, "RequestQuote"),
            (Icons.Material.Filled.Rule, "Rule"),
            (Icons.Material.Filled.Settings, "Settings"),
        };
    }
}
