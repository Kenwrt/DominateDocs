@code
{
    [Parameter] public EventCallback<DominateDocsData.Models.LoanAgreement> OnLoanAgreementComplete { get; set; }
    [Parameter] public EventCallback OnLoanAgreementCancel { get; set; }
    [Parameter] public DominateDocsData.Models.LoanAgreement SelectedAgreement { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        vm.InitializePageCommand.Execute(SelectedAgreement);
    }

    private bool _loanSetupOpen = true, _loanTermsOpen, _partiesOpen, _propertyOpen, _feesOpen, _featuresOpen;

    private bool AddEditBroker = false;
    private bool AddEditBorrower = false;
    private bool AddEditProperty = false;
    private bool AddEditLender = false;
    private bool AddEditGuarantor = false;
    private bool EditLoanDetail = false;

    private void ToggleIndex(List<int> list, int index, bool add)
    {
        if (add && !list.Contains(index)) list.Add(index);
        else if (!add) list.Remove(index);
        vm.NotifyLoanChanged();
    }

    public void OnAddBorrower()
    {
        vm.SelectedBorrower = null;
        AddEditBorrower = true;
        StateHasChanged();
    }

    private void OnRemoveBorrower(DominateDocsData.Models.Borrower r)
    {
        vm.DeleteAgreementBorrowerCommand.Execute(r);
        StateHasChanged();
    }

    private void OnSelectedBorrower(DominateDocsData.Models.Borrower r)
    {
        vm.SelectedBorrower = r;
        AddEditBorrower = true;
        StateHasChanged();
    }

    private void OnBorrowerCanceled()
    {
        AddEditBorrower = false;
        StateHasChanged();
    }

    private void OnBorrowerComplete(DominateDocsData.Models.Borrower borrower)
    {
        vm.UpsertAgreementBorrowerCommand.Execute(borrower);
        AddEditBorrower = false;
        StateHasChanged();
    }

    // Other handlers (Broker, Lender, etc.) omitted for brevity but should remain in your file
    public void OnAddBroker() { AddEditBroker = true; vm.SelectedBroker = null; StateHasChanged(); }
    public void OnAddLender() { AddEditLender = true; vm.SelectedLender = null; StateHasChanged(); }
    public void OnAddGuarantor() { AddEditGuarantor = true; vm.SelectedGuarantor = null; StateHasChanged(); }
    public void OnAddProperty() { AddEditProperty = true; vm.SelectedProperty = null; StateHasChanged(); }
    private void OnRemoveBroker(DominateDocsData.Models.Broker r) { vm.DeleteAgreementBrokerCommand.Execute(r); }
    private void OnRemoveLender(DominateDocsData.Models.Lender r) { vm.DeleteAgreementLenderCommand.Execute(r); }
    private void OnRemoveGuarantor(DominateDocsData.Models.Guarantor r) { vm.DeleteAgreementGuarantorCommand.Execute(r); }
    private void OnRemoveProperty(DominateDocsData.Models.PropertyRecord r) { vm.DeleteAgreementPropertyCommand.Execute(r); }
    private void OnBrokerComplete(DominateDocsData.Models.Broker b) { vm.UpsertAgreementBrokerCommand.Execute(b); AddEditBroker = false; StateHasChanged(); }
    private void OnLenderComplete(DominateDocsData.Models.Lender l) { vm.UpsertAgreementLenderCommand.Execute(l); AddEditLender = false; StateHasChanged(); }
    private void OnGuarantorComplete(DominateDocsData.Models.Guarantor g) { vm.UpsertAgreementGuarantorCommand.Execute(g); AddEditGuarantor = false; StateHasChanged(); }
    
    private void OnSelectedLender(DominateDocsData.Models.Lender r) { vm.SelectedLender = r; AddEditLender = true; StateHasChanged(); }
    private void OnLenderCanceled() { AddEditLender = false; StateHasChanged(); }

    private void OnSelectedGuarantor(DominateDocsData.Models.Guarantor r) { vm.SelectedGuarantor = r; AddEditGuarantor = true; StateHasChanged(); }
    private void OnGuarantorCanceled() { AddEditGuarantor = false; StateHasChanged(); }

    private void OnSelectedBroker(DominateDocsData.Models.Broker r) { vm.SelectedBroker = r; AddEditBroker = true; StateHasChanged(); }
    private void OnBrokerCanceled() { AddEditBroker = false; StateHasChanged(); }

    private void OnPropertyComplete(DominateDocsData.Models.PropertyRecord p) { vm.UpsertAgreementPropertyCommand.Execute(p); AddEditProperty = false; StateHasChanged(); }
}