@using DominateDocsData.Enums
@using DominateDocsData.Models
@using DominateDocsSite.ViewModels
@inject LoanWizardGuarantorViewModel vm
@inject ISnackbar Snackbar

<div @key="vm.EditingRecord">
    <MudPaper Outlined="true" Class="pa-4 mt-4" Style="border-radius: 12px; border: 1px solid #e0e0e0;">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Outlined.Security" Size="Size.Medium" Color="Color.Default" />
                <MudText Typo="Typo.h6" Style="font-weight: 600;">Guarantor(s)</MudText>
            </MudStack>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="HandleAdd">Add Guarantor</MudButton>
        </MudStack>

        <MudAutocomplete T="DominateDocsData.Models.Guarantor"
                         Label="Search saved guarantors..."
                         Value="@vm.SelectedRecord"
                         ValueChanged="@(async (DominateDocsData.Models.Guarantor b) => await vm.InitializePageCommand.ExecuteAsync(b))"
                         SearchFunc="@SearchFunc"
                         ToStringFunc="@(b => b?.EntityName ?? b?.ContactName)"
                         Variant="Variant.Outlined"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Default"
                         Class="mb-4"
                         Dense="true"
                         Margin="Margin.Dense" />

        <MudStack Row Spacing="2" Class="mb-6">
            <MudButton Variant="@(vm.EditingRecord.EntityType == Entity.Types.Individual ? Variant.Filled : Variant.Outlined)"
                       Color="@(vm.EditingRecord.EntityType == Entity.Types.Individual ? Color.Dark : Color.Default)"
                       OnClick="@(() => SetEntityType(Entity.Types.Individual))"
                       Style="border-radius: 20px; text-transform: none; min-width: 100px;">Individual</MudButton>
            <MudButton Variant="@(vm.EditingRecord.EntityType == Entity.Types.Entity ? Variant.Filled : Variant.Outlined)"
                       Color="@(vm.EditingRecord.EntityType == Entity.Types.Entity ? Color.Dark : Color.Default)"
                       OnClick="@(() => SetEntityType(Entity.Types.Entity))"
                       Style="border-radius: 20px; text-transform: none; min-width: 100px;">Entity</MudButton>
            <MudButton Variant="@(vm.EditingRecord.EntityType == Entity.Types.Trust ? Variant.Filled : Variant.Outlined)"
                       Color="@(vm.EditingRecord.EntityType == Entity.Types.Trust ? Color.Dark : Color.Default)"
                       OnClick="@(() => SetEntityType(Entity.Types.Trust))"
                       Style="border-radius: 20px; text-transform: none; min-width: 100px;">Trust</MudButton>
        </MudStack>

        <MudGrid Spacing="2">
            @if (vm.EditingRecord.EntityType == Entity.Types.Individual)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="vm.EditingRecord.ContactName" Label="FULL LEGAL NAME *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="vm.EditingRecord.SSN" Label="SSN *" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  InputAttributes="@GetMaskAttributes("guarantor-ssn", "ssn", "11")" />
                </MudItem>
            }
            else if (vm.EditingRecord.EntityType == Entity.Types.Entity)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="vm.EditingRecord.EntityName" Label="ENTITY NAME *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="vm.EditingRecord.EIN" Label="EIN *" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  InputAttributes="@GetMaskAttributes("guarantor-ein", "ein", "10")" />
                </MudItem>
            }
            else if (vm.EditingRecord.EntityType == Entity.Types.Trust)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="vm.EditingRecord.EntityName" Label="TRUST NAME *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="vm.EditingRecord.ContactEmail" Label="EMAIL *" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="vm.EditingRecord.ContactPhoneNumber" Label="PHONE" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              InputAttributes="@GetMaskAttributes("guarantor-phone", "phone", "14")" />
            </MudItem>

            <MudItem xs="12">
                <div style="margin-left: -16px; margin-right: -12px;">
                    <AddressCompleteMap AddressList="@addressList" OnAddressChange="HandleAddressChange" Row="false" MultipleAddress="false" />
                </div>
            </MudItem>
        </MudGrid>

        <MudStack Row Justify="Justify.Center" Spacing="2" Class="mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="HandleUpsert" Style="min-width: 120px; border-radius: 8px;">Add</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="HandleCancel" Style="min-width: 120px; border-radius: 8px;">Clear</MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    [Parameter] public DominateDocsData.Models.Guarantor SelectedGuarantor { get; set; }
    [Parameter] public EventCallback<DominateDocsData.Models.Guarantor> OnGuarantorComplete { get; set; }
    [Parameter] public EventCallback OnGuarantorCanceled { get; set; }

    private List<AddressDTO> addressList = new();

    protected override async Task OnInitializedAsync()
    {
        vm.SetSnackbar(Snackbar);
        await vm.InitializePageCommand.ExecuteAsync(SelectedGuarantor);
        SyncAddressList();
    }

    private void HandleAdd()
    {
        vm.ClearSelectionCommand.Execute(null);
        SyncAddressList();
        StateHasChanged();
    }

    private void SyncAddressList()
    {
        addressList.Clear();
        if (!string.IsNullOrEmpty(vm.EditingRecord.FullAddress))
        {
            addressList.Add(new AddressDTO
            {
                FullAddress = vm.EditingRecord.FullAddress,
                StreetAddress = vm.EditingRecord.StreetAddress,
                City = vm.EditingRecord.City,
                State = vm.EditingRecord.State,
                ZipCode = vm.EditingRecord.ZipCode,
                County = vm.EditingRecord.County,
                Country = vm.EditingRecord.Country,
                Lat = vm.EditingRecord.Lat ?? 0,
                Lng = vm.EditingRecord.Lng ?? 0
            });
        }
    }

    private void HandleAddressChange(List<AddressDTO> addresses)
    {
        var addr = addresses.FirstOrDefault();
        if (addr != null)
        {
            vm.EditingRecord.FullAddress = addr.FullAddress;
            vm.EditingRecord.StreetAddress = addr.StreetAddress;
            vm.EditingRecord.City = addr.City;
            vm.EditingRecord.State = addr.State;
            vm.EditingRecord.ZipCode = addr.ZipCode;
            vm.EditingRecord.County = addr.County;
            vm.EditingRecord.Country = addr.Country;
            vm.EditingRecord.Lat = addr.Lat;
            vm.EditingRecord.Lng = addr.Lng;
        }
    }

    private void SetEntityType(Entity.Types type)
    {
        vm.EditingRecord.EntityType = type;
        StateHasChanged();
    }

    private async Task HandleUpsert()
    {
        await vm.UpsertRecordCommand.ExecuteAsync(null);
        if (vm.LastUpsertSucceeded && OnGuarantorComplete.HasDelegate)
        {
            await OnGuarantorComplete.InvokeAsync(vm.EditingRecord);
        }
    }

    private async Task HandleCancel()
    {
        vm.ClearSelectionCommand.Execute(null);
        SyncAddressList();
        if (OnGuarantorCanceled.HasDelegate)
        {
            await OnGuarantorCanceled.InvokeAsync();
        }
    }

    private async Task<IEnumerable<DominateDocsData.Models.Guarantor>> SearchFunc(string value, System.Threading.CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return vm.RecordList;
        return vm.RecordList.Where(x => (x.EntityName ?? x.ContactName ?? "").Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private Dictionary<string, object> GetMaskAttributes(string id, string mask, string maxlength)
    {
        return new Dictionary<string, object>
        {
            { "id", id },
            { "data-mask", mask },
            { "maxlength", maxlength }
        };
    }
}
